    "/api/v1/audit-history": {
      "get": {
        "operationId": "AuditHistoryController_list",
        "parameters": [
          {
            "name": "garageId",
            "required": false,
            "in": "query",
            "description": "Staff: their own garage only; admin: any garage",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "required": false,
            "in": "query",
            "description": "Who made the change",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "area",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "requests",
                "quotes",
                "bookings",
                "jobs",
                "prices",
                "repair_history",
                "photos",
                "garage_profile",
                "team",
                "settings",
                "admin_actions"
              ]
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Inclusive; 7 days before now when absent",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Inclusive",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "The nextCursor of the previous page",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditHistoryPageDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "audit-history"
        ]
      }
    },
