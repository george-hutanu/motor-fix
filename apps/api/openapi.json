  "info": {
    "title": "MotorFix API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthLiveDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "postgres": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "storage": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        },
        "required": [
          "postgres",
          "redis",
          "storage"
        ]
      },
      "HealthReadyDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          },
          "version": {
            "type": "string",
            "description": "The deployed commit SHA, or dev"
          }
        },
        "required": [
          "status",
          "checks",
          "version"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Trimmed; compared without letter case",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "remember": {
            "type": "boolean",
            "default": true,
            "description": "Keep the session after the browser closes"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token, valid 15 minutes; keep it in memory"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Trimmed",
            "maxLength": 80,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "description": "Trimmed; stored and compared in lower case",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "description": "8 to 128 characters, not a common password",
            "maxLength": 1024,
            "minLength": 1
          },
          "language": {
            "type": "string",
            "description": "The interface language",
            "enum": [
              "ro",
              "en"
            ]
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "language"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "emailConfirmed": {
            "type": "boolean",
            "description": "Whether the e-mail is confirmed; false when there is none"
          },
          "language": {
            "type": "string",
            "enum": [
              "ro",
              "en"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "driver",
                "garage",
                "receptionist",
                "mechanic",
                "admin"
              ]
            }
          },
          "role": {
            "type": "string",
            "description": "The role in use",
            "enum": [
              "driver",
              "garage",
              "receptionist",
              "mechanic",
              "admin"
            ]
          },
          "garageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "capabilities": {
            "description": "What the role in use may do",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "landing": {
            "type": "string",
            "enum": [
              "/app/driver",
              "/app/garage",
              "/app/admin"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailConfirmed",
          "language",
          "roles",
          "role",
          "garageId",
          "capabilities",
          "landing"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "ro",
              "en"
            ]
          }
        },
        "required": [
          "language"
        ]
      },
      "AuditActorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "First name, or \"MotorFix\" for the system"
          },
          "role": {
            "type": "string",
            "enum": [
              "driver",
              "owner",
              "receptionist",
              "mechanic",
              "admin",
              "system"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "AuditEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "open"
            ]
          },
          "subjectType": {
            "type": "string",
            "description": "The table the entry is about, e.g. quote"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "field": {
            "type": "string",
            "nullable": true
          },
          "oldValue": {
            "description": "The value as stored (money in bani, times in UTC)",
            "nullable": true,
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ]
          },
          "newValue": {
            "description": "The value as stored (money in bani, times in UTC)",
            "nullable": true,
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ]
          },
          "actor": {
            "$ref": "#/components/schemas/AuditActorDto"
          },
          "viaAssistant": {
            "type": "boolean"
          },
          "garageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "carId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "jobId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "internal": {
            "type": "boolean",
            "description": "Never shown to the driver"
          },
          "kind": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "at",
          "action",
          "subjectType",
          "subjectId",
          "field",
          "oldValue",
          "newValue",
          "actor",
          "viaAssistant",
          "garageId",
          "carId",
          "jobId",
          "internal",
          "kind",
          "text"
        ]
      },
      "AuditHistoryPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Newest first, 20 at most",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "total": {
            "type": "number",
            "description": "Entries matching the filters"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "total"
        ]
      },
      "TestMessageDto": {
        "type": "object",
        "properties": {
          "accountIds": {
            "description": "The accounts that get the test e-mail",
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "accountIds"
        ]
      },
      "TestMessageQueuedDto": {
        "type": "object",
        "properties": {
          "queued": {
            "type": "number",
            "description": "How many test e-mails were queued"
          }
        },
        "required": [
          "queued"
        ]
      },
      "NotificationGroupDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "offers",
              "bookings",
              "due_dates",
              "news",
              "reviews_history"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "types": {
            "description": "The notification types the switch covers",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "enabled",
          "types"
        ]
      },
      "NotificationPreferenceDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A notification type, e.g. QUOTE_RECEIVED"
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "push",
              "sms",
              "whatsapp"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "garageId": {
            "type": "string",
            "description": "The garage of a staff choice; null for a personal one",
            "format": "uuid",
            "nullable": true
          },
          "alwaysSent": {
            "type": "boolean",
            "description": "Sent whatever the person chooses"
          }
        },
        "required": [
          "type",
          "channel",
          "enabled",
          "garageId",
          "alwaysSent"
        ]
      },
      "NotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationGroupDto"
            }
          },
          "preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationPreferenceDto"
            }
          }
        },
        "required": [
          "groups",
          "preferences"
        ]
      },
      "UpdateNotificationGroupDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "offers",
              "bookings",
              "due_dates",
              "news",
              "reviews_history"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "enabled"
        ]
      },
      "UpdateNotificationPreferenceDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A notification type, e.g. QUOTE_RECEIVED"
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "push",
              "sms",
              "whatsapp"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "garageId": {
            "type": "string",
            "description": "The garage of a staff choice; null for a personal one",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "type",
          "channel",
          "enabled",
          "garageId"
        ]
      },
      "UpdateNotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "groups": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateNotificationGroupDto"
            }
          },
          "preferences": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateNotificationPreferenceDto"
            }
          }
        }
      },
      "ConfirmEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token of a confirmation link: 43 base64url characters",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "ConfirmEmailAnswerDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "LiveTestDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accountId"
        ]
      }
    }
  }
}
