{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "prefix": "mf",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "1mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/web/ngsw-config.json",
          "sourceMap": {
            "hidden": true,
            "scripts": true,
            "styles": false,
            "vendor": false
          }
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          },
          {
            "glob": "{maplibre-gl.css,maplibre-gl-worker.mjs}",
            "input": "node_modules/maplibre-gl/dist",
            "output": "map"
          }
        ],
        "browser": "apps/web/src/main.ts",
        "outputMode": "server",
        "outputPath": "dist/apps/web",
        "server": "apps/web/src/main.server.ts",
        "ssr": {
          "entry": "apps/web/src/server.ts"
        },
        "styles": [
          "libs/ui-cockpit/src/styles/cockpit.css",
          "apps/web/src/styles.css"
        ],
        "tsConfig": "apps/web/tsconfig.app.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "web:build:development"
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      },
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server"
    },
    "test": {
      "dependsOn": ["test-node"],
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "web:build:development",
        "exclude": [
          "server/**/*.spec.ts",
          "app/app.config.spec.ts",
          "app/app.config.server.adversary.spec.ts"
        ],
        "isolate": true,
        "runner": "vitest",
        "runnerConfig": "apps/web/vitest.config.ts",
        "setupFiles": ["apps/web/src/test-setup.ts"],
        "splitting": false,
        "tsConfig": "apps/web/tsconfig.spec.json"
      }
    },
    "test-node": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "web:build:development",
        "include": [
          "server/**/*.spec.ts",
          "app/app.config.spec.ts",
          "app/app.config.server.adversary.spec.ts"
        ],
        "isolate": true,
        "runner": "vitest",
        "runnerConfig": "apps/web/vitest-node.config.ts",
        "setupFiles": ["apps/web/src/test-setup.ts"],
        "tsConfig": "apps/web/tsconfig.spec.json"
      }
    },
    "test:mutation": {},
    "typecheck": {
      "cache": true,
      "command": "ngc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/web/tsconfig.spec.json"
    }
  }
}
