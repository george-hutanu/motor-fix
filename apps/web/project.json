{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "prefix": "mf",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "1mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "browser": "apps/web/src/main.ts",
        "outputMode": "server",
        "outputPath": "dist/apps/web",
        "server": "apps/web/src/main.server.ts",
        "ssr": {
          "entry": "apps/web/src/server.ts"
        },
        "styles": [
          "libs/ui-cockpit/src/styles/cockpit.css",
          "apps/web/src/styles.css"
        ],
        "tsConfig": "apps/web/tsconfig.app.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "web:build:development"
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      },
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/web/jest.config.cts",
        "tsConfig": "apps/web/tsconfig.spec.json"
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "test:mutation": {},
    "typecheck": {
      "cache": true,
      "command": "ngc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/web/tsconfig.spec.json"
    }
  }
}
