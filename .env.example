# Every variable the apps read. Values live in Railway per environment and in
# your local .env, never in the repository.
# One of: development, test, staging, production
APP_ENV=development
# api, worker
DATABASE_URL=
REDIS_URL=
# api: signs and checks access tokens
AUTH_TOKEN_SECRET=
# web
API_INTERNAL_URL=
PUBLIC_WEB_URL=
# api, worker: a private S3-compatible bucket in an EU region; locally the
# docker compose MinIO (http://localhost:9000, bucket motorfix)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# api, worker: e-mail through Brevo. Sending stays off until EMAIL_SENDING=on;
# outside production only EMAIL_ALLOWLIST (addresses and @domain entries) is
# mailed, and an empty list mails nobody.
EMAIL_SENDING=off
EMAIL_ALLOWLIST=
# worker: the sender, e.g. MotorFix <noreply@your-domain>, and the Brevo API key
EMAIL_FROM=
BREVO_API_KEY=
# api: the bearer token Brevo's transactional webhook sends to
# /api/v1/webhooks/brevo; without it the webhook refuses every call
BREVO_WEBHOOK_SECRET=
# seed (libs/domain/src/seed.ts): the seeded accounts' password; required in
# staging, a fake default elsewhere. web-e2e reads the same one as E2E_PASSWORD.
SEED_PASSWORD=
E2E_PASSWORD=
# all; defaults to dev
RELEASE_SHA=
# all; set by Railway
PORT=
