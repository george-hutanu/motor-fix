# Every variable the apps read. Values live in Railway per environment and in
# your local .env, never in the repository.
# One of: development, test, staging, production
APP_ENV=
# api, worker
DATABASE_URL=
REDIS_URL=
# api: signs and checks access tokens
AUTH_TOKEN_SECRET=
# web
API_INTERNAL_URL=
PUBLIC_WEB_URL=
# api, worker: a private S3-compatible bucket in an EU region; locally the
# docker compose MinIO (http://localhost:9000, bucket motorfix)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# seed (libs/domain/src/seed.ts): the seeded accounts' password; required in
# staging, a fake default elsewhere. web-e2e reads the same one as E2E_PASSWORD.
SEED_PASSWORD=
E2E_PASSWORD=
# all; defaults to dev
RELEASE_SHA=
# all; set by Railway
PORT=
