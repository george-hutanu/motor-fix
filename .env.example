# Every variable the apps read. Values live in Railway per environment and in
# your local .env, never in the repository.
# One of: development, test, staging, production
APP_ENV=development
# api, worker
DATABASE_URL=
REDIS_URL=
# worker: the read-only motorfix_monitor role's address for the data-store
# readings (unset leaves the PostgreSQL readings off); api pre-deploy: that
# role's password, applied after the migrations (unset skips it)
MONITOR_DATABASE_URL=
MONITOR_DATABASE_PASSWORD=
# worker: the amber and red limits of the admin dashboard's six service tiles
# (the build team's defaults below); unset or invalid leaves the checks off
STATUS_THRESHOLDS={"api":{"amber_ms":500,"red_ms":2000},"search":{"amber_ms":800,"red_ms":3000},"maps":{"amber_ms":1500,"red_ms":5000},"email":{"amber_ms":2000,"red_ms":8000,"amber_share":0.1,"red_share":0.5},"notifications":{"amber_age_s":300,"red_age_s":900,"amber_share":0.1,"red_share":0.5},"backup":{"amber_h":26,"red_h":50}}
# worker: read access to the nightly backup bucket, for the backup tile; the
# names the backup workflow uses. Any one unset shows the tile red.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# api: signs and checks access tokens; worker: signs the news unsubscribe links
AUTH_TOKEN_SECRET=
# web
API_INTERNAL_URL=
# web; worker and api too: every e-mail's button opens it, and the api writes
# the e-mail confirmation link with it
PUBLIC_WEB_URL=
# api: sign-in with Google and Apple. A provider's button shows only when all
# its keys and PUBLIC_WEB_URL are set; the provider returns to
# PUBLIC_WEB_URL/api/v1/auth/oauth/<google|apple>/callback. APPLE_PRIVATE_KEY is
# the .p8 key's PEM, line breaks written as \n allowed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# api, development and test only: a stand-in issuer instead of the real one
# (end-to-end: http://127.0.0.1:3026)
GOOGLE_ISSUER=
APPLE_ISSUER=
# mcp, api: AI assistants. MCP_URL is the MCP server's public address and the
# audience of an assistant's token (locally http://127.0.0.1:3002/mcp);
# ASSISTANT_ISSUER is the identity server's realm (locally
# http://127.0.0.1:8081/realms/motorfix-assistants); ASSISTANT_TRUSTED_DOMAINS
# is one host the realm trusts besides claude.ai, chatgpt.com and openai.com
# (infra/keycloak/README.md). The
# ASSISTANT_BROKER_* values are the identity server's client at the api's
# sign-in routes: its id, its secret (a long random string, never committed)
# and the redirect address it registered.
MCP_URL=
ASSISTANT_ISSUER=
ASSISTANT_TRUSTED_DOMAINS=
ASSISTANT_BROKER_CLIENT_ID=
ASSISTANT_BROKER_CLIENT_SECRET=
ASSISTANT_BROKER_REDIRECT_URI=
# api, worker: a private S3-compatible bucket in an EU region; locally the
# docker compose object store, SeaweedFS (http://localhost:9000, bucket motorfix)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# api, worker: e-mail through Brevo. Sending stays off until EMAIL_SENDING=on;
# outside production only EMAIL_ALLOWLIST (addresses and @domain entries) is
# mailed, and an empty list mails nobody.
EMAIL_SENDING=off
EMAIL_ALLOWLIST=
# api, worker: the one domain all MotorFix e-mail comes from (e.g.
# mail.example.ro). It gives the sender MotorFix <no-reply@domain>, the support
# address support@domain when SUPPORT_EMAIL is unset (the reply-to of every
# automatic e-mail) and the DNS records the worker's email-dns-check reads.
EMAIL_DOMAIN=
# worker: the test mailboxes, comma-separated, the worker's inbox-test sends
# every e-mail to (node dist/apps/worker/main.js inbox-test [--dry-run])
INBOX_TEST_TO=
# worker: the sender, unset to use no-reply@EMAIL_DOMAIN; with EMAIL_DOMAIN set
# it must be an address at that domain. And the Brevo API key.
EMAIL_FROM=
BREVO_API_KEY=
# api: the bearer token Brevo's transactional webhook sends to
# /api/v1/webhooks/brevo; without it the webhook refuses every call
BREVO_WEBHOOK_SECRET=
# api, worker: the contact form. SUPPORT_EMAIL is the mailbox its messages go
# to and the address the contact and maintenance pages show (on any domain;
# unset, support@EMAIL_DOMAIN); with neither, the page
# shows only the form, the messages wait unsent and the worker logs it.
# SUPPORT_AWAY_UNTIL (YYYY-MM-DD, Bucharest) moves the promised answer to the
# first working day on or after it; past or unreadable reads as unset.
SUPPORT_EMAIL=
SUPPORT_AWAY_UNTIL=
# The bearer token Grafana's outage contact point sends to
# POST /api/v1/monitoring/outage-alerts; unset refuses every call.
OUTAGE_WEBHOOK_TOKEN=
# api and worker: SMS and WhatsApp through Brevo, with BREVO_API_KEY (the api
# sends the sign-in codes). Sending stays off until PHONE_SENDING=on, which
# needs WHATSAPP_SENDER (the WhatsApp Business number); outside production only
# PHONE_ALLOWLIST is sent to: E.164 numbers, or a prefix ending in * (+4070000*).
# WHATSAPP_TEMPLATES maps each approved template name to its Brevo id
# (motorfix_due_itp_ro=12,motorfix_sign_in_code_ro=14); an unlisted one goes by
# e-mail, and a sign-in code without one is not sent.
PHONE_SENDING=off
PHONE_ALLOWLIST=
SMS_SENDER=MotorFix
WHATSAPP_SENDER=
WHATSAPP_TEMPLATES=
# api: SKIP_MANUAL_APPROVAL=true approves every garage verification file at
# once, as MotorFix. Honoured only when APP_ENV=test; ignored everywhere else.
SKIP_MANUAL_APPROVAL=
# api and worker: web push. All three or none (push stays off); generate the
# pair with `npx web-push generate-vapid-keys`; the subject is mailto: or https://.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# worker, test and development only: a reminder day lasts this many
# milliseconds, so the 30-day and 7-day reminders can be watched end to end.
# The worker refuses to start with it in staging or production.
# REMINDER_DAY_MS=
# seed (libs/domain/src/seed.ts): the seeded accounts' password; required in
# staging, a fake default elsewhere. web-e2e reads the same one as E2E_PASSWORD.
SEED_PASSWORD=
E2E_PASSWORD=
# all; defaults to dev
RELEASE_SHA=
# all; set by Railway
PORT=
# api, worker (libs/contracts placesApiKey()): Geoapify key for the address search of step 5; optional.
# Unset: the search answers 503 and the owner places the pin by hand (APP_ENV=test uses a fixed fake).
GEOAPIFY_API_KEY=
# api, worker, web (libs/contracts telemetry()): optional, unset means telemetry off.
# Staging and production: Grafana Cloud's OTLP gateway
# (https://otlp-gateway-prod-eu-west-2.grafana.net/otlp) and its Authorization
# header, percent-encoded (Authorization=Basic%20...), set in Railway by the owner. Locally: http://localhost:4318 with
# `docker compose --profile observability up -d otel-lgtm`. Protocol: http/protobuf.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=
# Browser telemetry collector (Grafana Faro); unset sends nothing.
FARO_URL=
# web: the site name Plausible counts page views under (e.g. motorfix.ro); unset loads no analytics, whatever the visitor chose.
PLAUSIBLE_DOMAIN=
# Grafana stack URL (e.g. https://<stack>.grafana.net) the admin panel links to; unset shows no link.
GRAFANA_URL=
