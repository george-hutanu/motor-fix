# Every variable the apps read. Values live in Railway per environment and in
# your local .env, never in the repository.
# One of: development, test, staging, production
APP_ENV=
# api, worker
DATABASE_URL=
REDIS_URL=
# web
API_INTERNAL_URL=
PUBLIC_WEB_URL=
# web, at build time: the PrimeUI licence key, passed to the build as
# npx nx run web:build "--define.PRIMEUI_LICENSE='\"$PRIMEUI_LICENSE\"'"
# Without it PrimeNG shows a small "Invalid PrimeUI License" notice.
PRIMEUI_LICENSE=
# all; defaults to dev
RELEASE_SHA=
# all; set by Railway
PORT=
