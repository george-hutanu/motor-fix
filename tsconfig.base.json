        "./libs/contracts/src/figure-choices.ts"
      ],
      "@motor-fix/contracts/files": ["./libs/contracts/src/files.ts"],
      "@motor-fix/contracts/fold": ["./libs/contracts/src/fold.ts"],
      "@motor-fix/contracts/garage-hours": [
        "./libs/contracts/src/garage-hours.ts"
      ],
      "@motor-fix/contracts/garage-report-text": [
