        "./libs/contracts/src/listing-verification.ts"
      ],
      "@motor-fix/contracts/marked-brands": [
        "./libs/contracts/src/marked-brands.ts"
      ],
      "@motor-fix/contracts/notification-groups": [
        "./libs/contracts/src/notification-groups.ts"
      ],
      "@motor-fix/contracts/phone": ["./libs/contracts/src/phone.ts"],
      "@motor-fix/contracts/place-section": [
        "./libs/contracts/src/place-section.ts"
      ],
      "@motor-fix/contracts/plate": ["./libs/contracts/src/plate.ts"],
      "@motor-fix/contracts/price-range": [
        "./libs/contracts/src/price-range.ts"
