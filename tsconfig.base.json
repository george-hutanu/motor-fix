{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": ["es2024", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "paths": {
      "@motor-fix/contracts": ["./libs/contracts/src/index.ts"],
      "@motor-fix/contracts/consent": ["./libs/contracts/src/consent.ts"],
      "@motor-fix/contracts/email": ["./libs/contracts/src/email.ts"],
      "@motor-fix/contracts/env": ["./libs/contracts/src/env.ts"],
      "@motor-fix/contracts/fold": ["./libs/contracts/src/fold.ts"],
      "@motor-fix/contracts/garage-hours": [
        "./libs/contracts/src/garage-hours.ts"
      ],
      "@motor-fix/contracts/listing-sections": [
        "./libs/contracts/src/listing-sections.ts"
      ],
      "@motor-fix/contracts/listing-verification": [
        "./libs/contracts/src/listing-verification.ts"
      ],
      "@motor-fix/contracts/phone": ["./libs/contracts/src/phone.ts"],
      "@motor-fix/contracts/price-range": [
        "./libs/contracts/src/price-range.ts"
      ],
      "@motor-fix/contracts/problem": ["./libs/contracts/src/problem.ts"],
      "@motor-fix/data-access": ["./libs/data-access/src/index.ts"],
      "@motor-fix/domain": ["./libs/domain/src/index.ts"],
      "@motor-fix/domain/testing": [
        "./libs/domain/src/storage/s3-test-store.ts"
      ],
      "@motor-fix/i18n": ["./libs/i18n/src/index.ts"],
      "@motor-fix/i18n/formats": ["./libs/i18n/src/formats.ts"],
      "@motor-fix/media": ["./libs/media/src/index.ts"],
      "@motor-fix/overlays": ["./libs/overlays/src/index.ts"],
      "@motor-fix/ui-cockpit": ["./libs/ui-cockpit/src/index.ts"],
      "@motor-fix/ui-cockpit/email": ["./libs/ui-cockpit/src/email.ts"],
      "@motor-fix/ui-cockpit/sample": ["./libs/ui-cockpit/src/sample.ts"]
    },
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2023"
  },
  "exclude": ["node_modules", "tmp", ".claude", ".specify", ".worktrees"]
}
