[
  {
    "id": "leaves-a-slow-spec-to-the-stop-gate",
    "hook": "post:edit:affected-tests",
    "why": "Jest's last time on the edited spec was 5 s or more (a record dated ahead, so it never ages past 7 days), so the edit does not wait for it; the hook says which spec it left to the Stop gate instead of passing silently",
    "fixture": {
      "commits": [
        {
          "files": {
            "libs/demo/src/demo.spec.ts": "it('holds', () => {});\n",
            ".specify/.cache/spec-durations.json": "{\"libs/demo/src/demo.spec.ts\":{\"ms\":9000,\"at\":\"2099-01-01T00:00:00.000Z\"}}\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 0,
      "stdout": "additionalContext.*libs/demo/src/demo\\.spec\\.ts was not run"
    }
  },
  {
    "id": "runs-the-spec-when-the-duration-script-crashes",
    "hook": "post:edit:affected-tests",
    "why": "only the duration script's exit 1 means slow; a crash (here exit 2) must not turn every per-edit run off, so the spec still runs (a stub jest that fails proves it ran; the stub duration script makes it executable, as the fixture writes plain files)",
    "fixture": {
      "commits": [
        {
          "files": {
            "libs/demo/src/demo.spec.ts": "it('holds', () => {});\n",
            "node_modules/.bin/jest": "#!/bin/sh\necho stub jest ran >&2\nexit 1\n",
            ".claude/scripts/lib/spec-durations.mjs": "import { chmodSync } from 'node:fs';\nchmodSync('node_modules/.bin/jest', 0o755);\nprocess.exit(2);\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "Affected tests failed: libs/demo/src/demo\\.spec\\.ts"
    }
  },
  {
    "id": "leaves-a-red-first-spec-unrun",
    "hook": "post:edit:affected-tests",
    "why": "a spec new on the branch (absent at the base, SPECKIT_BASE_REF) that imports a file not written yet is red-first by design: the hook answers with one note naming the missing import and runs no Jest (the stub Jest, made executable only by the duration step, would fail the edit if it ran)",
    "env": {
      "SPECKIT_BASE_REF": "HEAD~1"
    },
    "fixture": {
      "commits": [
        {
          "files": {
            "README.md": "base\n"
          }
        },
        {
          "files": {
            "libs/demo/src/demo.spec.ts": "import { demo } from './demo';\n\nit('holds', () => expect(demo()).toBe(1));\n",
            "node_modules/.bin/jest": "#!/bin/sh\necho stub jest ran >&2\nexit 1\n",
            ".claude/scripts/lib/spec-durations.mjs": "import { chmodSync } from 'node:fs';\nchmodSync('node_modules/.bin/jest', 0o755);\nprocess.exit(0);\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Write",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 0,
      "stdout": "additionalContext.*libs/demo/src/demo\\.spec\\.ts was not run.*red-first.*\\./demo"
    }
  },
  {
    "id": "runs-an-existing-spec-that-fails",
    "hook": "post:edit:affected-tests",
    "why": "a spec already present at the base is never red-first, even when its import is missing: it runs, and its failure still blocks the edit",
    "env": {
      "SPECKIT_BASE_REF": "HEAD~1"
    },
    "fixture": {
      "commits": [
        {
          "files": {
            "libs/demo/src/demo.spec.ts": "import { demo } from './demo';\n\nit('holds', () => expect(demo()).toBe(1));\n"
          }
        },
        {
          "files": {
            "libs/demo/src/demo.spec.ts": "import { demo } from './demo';\n\nit('holds', () => expect(demo()).toBe(2));\n",
            "node_modules/.bin/jest": "#!/bin/sh\necho stub jest ran >&2\nexit 1\n",
            ".claude/scripts/lib/spec-durations.mjs": "import { chmodSync } from 'node:fs';\nchmodSync('node_modules/.bin/jest', 0o755);\nprocess.exit(0);\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "Affected tests failed: libs/demo/src/demo\\.spec\\.ts"
    }
  },
  {
    "id": "runs-a-vitest-project-spec-through-vitest",
    "hook": "post:edit:affected-tests",
    "why": "a spec in a project with a vitest.config.mts is a Vitest spec: Jest would fail it on vi.* or its config, so the hook runs it through Vitest with that config (a failing stub vitest beside a passing stub jest proves which one ran; the stub duration script makes both executable)",
    "fixture": {
      "commits": [
        {
          "files": {
            "libs/demo/vitest.config.mts": "export default {};\n",
            "libs/demo/src/demo.spec.ts": "it('holds', () => {});\n",
            "node_modules/.bin/vitest": "#!/bin/sh\necho stub vitest ran \"$@\" >&2\nexit 1\n",
            "node_modules/.bin/jest": "#!/bin/sh\nexit 0\n",
            ".claude/scripts/lib/spec-durations.mjs": "import { chmodSync } from 'node:fs';\nfor (const bin of ['jest', 'vitest']) chmodSync(`node_modules/.bin/${bin}`, 0o755);\nprocess.exit(0);\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "stub vitest ran run --config libs/demo/vitest\\.config\\.mts libs/demo/src/demo\\.spec\\.ts[\\s\\S]*Affected tests failed: libs/demo/src/demo\\.spec\\.ts"
    }
  },
  {
    "id": "keeps-jest-for-a-project-without-a-vitest-config",
    "hook": "post:edit:affected-tests",
    "why": "the Angular projects still run on Jest: a spec whose project has no vitest.config.mts goes to Jest, so a failing stub vitest is never reached and the passing stub jest lets the edit through",
    "fixture": {
      "commits": [
        {
          "files": {
            "libs/demo/jest.config.cts": "module.exports = {};\n",
            "libs/demo/src/demo.spec.ts": "it('holds', () => {});\n",
            "node_modules/.bin/vitest": "#!/bin/sh\necho stub vitest ran >&2\nexit 1\n",
            "node_modules/.bin/jest": "#!/bin/sh\nexit 0\n",
            ".claude/scripts/lib/spec-durations.mjs": "import { chmodSync } from 'node:fs';\nfor (const bin of ['jest', 'vitest']) chmodSync(`node_modules/.bin/${bin}`, 0o755);\nprocess.exit(0);\n"
          }
        }
      ]
    },
    "payload": {
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "libs/demo/src/demo.spec.ts"
      }
    },
    "expect": {
      "exit": 0
    }
  }
]
