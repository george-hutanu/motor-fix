[
  {
    "id": "blocks-force-push",
    "hook": "pre:bash:guard",
    "why": "a force-push can erase a colleague's commits, and nothing in this repo's workflow needs one",
    "payload": {
      "tool_input": {
        "command": "git push --force origin BKP-1304"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "force-push"
    }
  },
  {
    "id": "allows-force-with-lease",
    "hook": "pre:bash:guard",
    "why": "--force-with-lease refuses when the remote moved, which is the safe form the block points at",
    "payload": {
      "tool_input": {
        "command": "git push --force-with-lease origin BKP-1304"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "blocks-hard-reset",
    "hook": "pre:bash:guard",
    "why": "a hard reset throws away uncommitted work with no copy anywhere",
    "payload": {
      "tool_input": {
        "command": "git reset --hard origin/main"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "destroys uncommitted work"
    }
  },
  {
    "id": "blocks-clean-force",
    "hook": "pre:bash:guard",
    "why": "specs/, .specify/ and .claude/ are all untracked here, so a forced clean deletes the whole harness",
    "payload": {
      "tool_input": {
        "command": "git clean -fd"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "untracked files"
    }
  },
  {
    "id": "blocks-deleting-the-work-directory",
    "hook": "pre:bash:guard",
    "why": ".work/ holds cloned repos and scan outputs that cost minutes to hours to reproduce",
    "payload": {
      "tool_input": {
        "command": "rm -rf .work/scan"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "expensive state"
    }
  },
  {
    "id": "allows-a-runtime-dependency-install",
    "hook": "pre:bash:guard",
    "why": "this is the rule speckit-demo has and this repo deliberately dropped — every workspace here ships runtime dependencies, and blocking that would fight normal work",
    "payload": {
      "tool_input": {
        "command": "npm install fastify -w apps/server"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "allows-a-push-to-the-feature-branch",
    "hook": "pre:bash:guard",
    "why": "work on a task pushes every commit to its own branch behind a draft PR; blocking that would stop the PR following the work",
    "payload": {
      "tool_input": {
        "command": "git push origin 079-account-model"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "blocks-a-push-to-main",
    "hook": "pre:bash:guard",
    "why": "main changes only through a PR merged on green CI; a direct push skips the review and the checks",
    "payload": {
      "tool_input": {
        "command": "git push origin main"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "pushing to main"
    }
  },
  {
    "id": "blocks-a-refspec-push-to-main",
    "hook": "pre:bash:guard",
    "why": "HEAD:main lands the same commits on main as naming the branch",
    "payload": {
      "tool_input": {
        "command": "git push origin HEAD:main"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "pushing to main"
    }
  },
  {
    "id": "allows-a-branch-named-after-main",
    "hook": "pre:bash:guard",
    "why": "a feature branch whose name merely contains main must still push",
    "payload": {
      "tool_input": {
        "command": "git push -u origin 101-main-menu"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "allows-ordinary-commands",
    "hook": "pre:bash:guard",
    "why": "a guard that costs a round trip on every `npm test` would be turned off within a day",
    "payload": {
      "tool_input": {
        "command": "npm test"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "profile-off-disarms-the-gate",
    "hook": "pre:bash:guard",
    "why": "the escape hatch has to work, or debugging a gate means editing it",
    "payload": {
      "tool_input": {
        "command": "git reset --hard origin/main"
      }
    },
    "env": {
      "SPECKIT_HOOK_PROFILE": "off"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "dry-run-reports-instead-of-blocking",
    "hook": "pre:bash:guard",
    "why": "watching a gate without being stopped by it is how you tell a false positive from a real one",
    "payload": {
      "tool_input": {
        "command": "git reset --hard origin/main"
      }
    },
    "env": {
      "SPECKIT_HOOKS_DRY_RUN": "1"
    },
    "expect": {
      "exit": 0,
      "stderr": "DRY RUN"
    }
  },
  {
    "id": "allows-specs-trunk-push",
    "hook": "pre:bash:guard",
    "why": "815-FR-007: specs/ is the private motor-fix-specs clone, whose records branch is trunk; pushing it is how a feature's records are saved",
    "payload": {
      "tool_input": {
        "command": "git -C specs push -q origin HEAD:trunk"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "blocks-main-push-beside-specs",
    "hook": "pre:bash:guard",
    "why": "815-FR-007: the specs repository's trunk is allowed, motor-fix's main still is not",
    "payload": {
      "tool_input": {
        "command": "git -C specs push origin HEAD:trunk && git push origin HEAD:main"
      }
    },
    "expect": {
      "exit": 2,
      "stderr": "pushing to main"
    }
  }
]
