[
  {
    "id": "merge-gate-refuses-without-agent-review",
    "hook": "pre:bash:merge-gate",
    "why": "a green CI says the code compiles and its own tests pass; only the PR tester says the change works when booted and used, and the merge waits for it (Constitution VII)",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 21, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "no agent-review status"
    }
  },
  {
    "id": "merge-gate-refuses-a-failing-agent-review",
    "hook": "pre:bash:merge-gate",
    "why": "a failure verdict means blocking findings are open; merging it is the silent merge the loop exists to prevent",
    "payload": {
      "tool_input": {
        "command": "GH_TOKEN=x gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 21, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"StatusContext\", \"context\": \"agent-review\", \"state\": \"FAILURE\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "agent-review is failure"
    }
  },
  {
    "id": "merge-gate-refuses-the-rest-merge-call",
    "hook": "pre:bash:merge-gate",
    "why": "the REST endpoint merges as surely as gh pr merge; a gate on one spelling only is a gate with a side door",
    "payload": {
      "tool_input": {
        "command": "gh api -X PUT repos/george-hutanu/motor-fix/pulls/21/merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 21, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "speckit-pr-test 21"
    }
  },
  {
    "id": "merge-gate-refuses-a-merge-with-the-repo-flag",
    "hook": "pre:bash:merge-gate",
    "why": "gh -R owner/repo is the spelling AGENTS.md teaches; a gate that only reads gh pr merge first fails open on it",
    "payload": {
      "tool_input": {
        "command": "gh -R george-hutanu/motor-fix pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 21, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "speckit-pr-test 21"
    }
  },
  {
    "id": "merge-gate-passes-with-agent-review-success",
    "hook": "pre:bash:merge-gate",
    "why": "with the tester's success on the head commit the merge is the next lifecycle step, and the gate must not stand in its way",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\":21,\"state\":\"OPEN\",\"headRefOid\":\"abc1234def5678\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"name\":\"checks\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"CheckRun\",\"name\":\"CI OK\",\"status\":\"COMPLETED\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"StatusContext\",\"context\":\"agent-review\",\"state\":\"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "merge-gate-passes-past-a-cancelled-earlier-run",
    "hook": "pre:bash:merge-gate",
    "why": "a body edit cancels the PR template run in progress and starts a new one; the cancelled run is history, not a red check",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\":21,\"state\":\"OPEN\",\"headRefOid\":\"abc1234def5678\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"name\":\"body\",\"status\":\"COMPLETED\",\"conclusion\":\"CANCELLED\",\"startedAt\":\"2026-10-05T07:03:51Z\"},{\"__typename\":\"CheckRun\",\"name\":\"body\",\"status\":\"COMPLETED\",\"conclusion\":\"SUCCESS\",\"startedAt\":\"2026-10-05T07:04:15Z\"},{\"__typename\":\"CheckRun\",\"name\":\"checks\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"CheckRun\",\"name\":\"CI OK\",\"status\":\"COMPLETED\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"StatusContext\",\"context\":\"agent-review\",\"state\":\"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "merge-gate-refuses-agent-review-success-on-red-ci",
    "hook": "pre:bash:merge-gate",
    "why": "the PR tester runs beside CI, so its success says nothing about CI; a red check still blocks the merge",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\":21,\"state\":\"OPEN\",\"headRefOid\":\"abc1234def5678\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"name\":\"checks\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"CheckRun\",\"name\":\"CI OK\",\"status\":\"COMPLETED\",\"conclusion\":\"FAILURE\"},{\"__typename\":\"StatusContext\",\"context\":\"agent-review\",\"state\":\"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "CI failed"
    }
  },
  {
    "id": "merge-gate-refuses-agent-review-success-while-ci-runs",
    "hook": "pre:bash:merge-gate",
    "why": "a merge before CI finishes is a merge CI never judged",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\":21,\"state\":\"OPEN\",\"headRefOid\":\"abc1234def5678\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"name\":\"checks\",\"conclusion\":\"SUCCESS\"},{\"__typename\":\"CheckRun\",\"name\":\"CI OK\",\"status\":\"IN_PROGRESS\",\"conclusion\":null},{\"__typename\":\"StatusContext\",\"context\":\"agent-review\",\"state\":\"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "still running"
    }
  },
  {
    "id": "merge-gate-ignores-other-commands",
    "hook": "pre:bash:merge-gate",
    "why": "merging origin/main into a branch is part of the lifecycle; only merging a PR is gated",
    "payload": {
      "tool_input": {
        "command": "git merge --no-edit origin/main"
      }
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "merge-gate-refuses-while-a-green-check-is-queued-again",
    "hook": "pre:bash:merge-gate",
    "why": "gh dates a run that has not started 0001-01-01; read as the oldest run, a queued re-run of a green check let the merge through on the old result",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 21 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\":21,\"state\":\"OPEN\",\"headRefOid\":\"abc1234def5678\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"workflowName\":\"CI\",\"name\":\"Unit tests\",\"status\":\"COMPLETED\",\"conclusion\":\"SUCCESS\",\"startedAt\":\"2026-10-05T07:00:00Z\"},{\"__typename\":\"CheckRun\",\"workflowName\":\"CI\",\"name\":\"Unit tests\",\"status\":\"QUEUED\",\"conclusion\":null,\"startedAt\":\"0001-01-01T00:00:00Z\"},{\"__typename\":\"CheckRun\",\"workflowName\":\"CI\",\"name\":\"CI OK\",\"status\":\"COMPLETED\",\"conclusion\":\"SUCCESS\",\"startedAt\":\"2026-10-05T07:00:00Z\"},{\"__typename\":\"StatusContext\",\"context\":\"agent-review\",\"state\":\"SUCCESS\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "still running"
    }
  },
  {
    "id": "merge-gate-refuses-a-green-human-pr-without-agent-review",
    "hook": "pre:bash:merge-gate",
    "why": "the Dependabot exemption is read off the author; a PR anyone else opened still waits for the PR tester however green its CI",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 82 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 82, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"author\": {\"login\": \"george-hutanu\", \"is_bot\": false}, \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"CI OK\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"CheckRun\", \"name\": \"body\", \"conclusion\": \"SKIPPED\"}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "no agent-review status"
    }
  },
  {
    "id": "merge-gate-passes-a-green-dependabot-pr",
    "hook": "pre:bash:merge-gate",
    "why": "a Dependabot version bump merges on every check green with no agent review (owner decision, Constitution VII)",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 82 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 82, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"author\": {\"login\": \"app/dependabot\", \"is_bot\": true}, \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"CI OK\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"CheckRun\", \"name\": \"body\", \"conclusion\": \"SKIPPED\"}], \"commits\": [{\"authors\": [{\"login\": \"dependabot[bot]\"}]}]}"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "merge-gate-refuses-a-red-dependabot-pr",
    "hook": "pre:bash:merge-gate",
    "why": "the exemption covers the agent review only; a failing check still keeps a Dependabot PR out of main",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 82 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 82, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"author\": {\"login\": \"app/dependabot\", \"is_bot\": true}, \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"CI OK\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"CheckRun\", \"name\": \"Unit tests\", \"conclusion\": \"FAILURE\"}], \"commits\": [{\"authors\": [{\"login\": \"dependabot[bot]\"}]}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "CI failed"
    }
  },
  {
    "id": "merge-gate-refuses-a-dependabot-pr-with-a-foreign-commit",
    "hook": "pre:bash:merge-gate",
    "why": "the PR author never changes when someone else pushes to the branch; a commit not written by Dependabot puts the PR back under the PR tester",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 82 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 82, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"author\": {\"login\": \"app/dependabot\", \"is_bot\": true}, \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"CI OK\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"CheckRun\", \"name\": \"body\", \"conclusion\": \"SKIPPED\"}], \"commits\": [{\"authors\": [{\"login\": \"dependabot[bot]\"}]}, {\"authors\": [{\"login\": \"george-hutanu\"}]}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "no agent-review status"
    }
  },
  {
    "id": "merge-gate-refuses-a-dependabot-pr-before-ci-ok",
    "hook": "pre:bash:merge-gate",
    "why": "the exemption skips the agent review, not CI: a Dependabot PR whose CI OK has not reported waits like any other",
    "payload": {
      "tool_input": {
        "command": "gh pr merge 82 --merge"
      }
    },
    "env": {
      "SPECKIT_PR_STATE": "{\"number\": 82, \"state\": \"OPEN\", \"headRefOid\": \"abc1234def5678\", \"author\": {\"login\": \"app/dependabot\", \"is_bot\": true}, \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"workflowName\": \"CI\", \"name\": \"Unit tests\", \"status\": \"COMPLETED\", \"conclusion\": \"SUCCESS\"}], \"commits\": [{\"authors\": [{\"login\": \"dependabot[bot]\"}]}]}"
    },
    "expect": {
      "exit": 2,
      "stderr": "no CI OK check"
    }
  }
]
