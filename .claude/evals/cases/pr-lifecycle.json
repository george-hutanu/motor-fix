[
  {
    "id": "pr-lifecycle-never-blocks-twice-in-a-row",
    "hook": "stop:pr-lifecycle",
    "why": "stop_hook_active means the gate already refused this turn; refusing again loops forever, and Claude Code's contract forbids it",
    "payload": {
      "stop_hook_active": true
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "pr-lifecycle-fails-open-outside-a-repository",
    "hook": "stop:pr-lifecycle",
    "why": "a gate that cannot read the branch has nothing to judge; trapping the session would punish a broken environment, not unfinished work",
    "payload": {
      "cwd": "/"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-green-pr-the-tester-has-not-passed",
    "hook": "stop:pr-lifecycle",
    "why": "a session that ends on a green ready PR with no agent review skips the QA step; the gate sends it to the tester instead of to the merge",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"feature-branch\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}]}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "speckit-pr-test 21"
    }
  },
  {
    "id": "pr-lifecycle-treats-a-tested-green-pr-as-mergeable",
    "hook": "stop:pr-lifecycle",
    "why": "with agent-review success on the head the PR is mergeable, and leaving it unmerged is the unfinished task Constitution VII refuses",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"feature-branch\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"StatusContext\", \"context\": \"agent-review\", \"state\": \"SUCCESS\"}]}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "Merge it"
    }
  },
  {
    "id": "pr-lifecycle-lets-the-fix-loop-own-a-failing-review",
    "hook": "stop:pr-lifecycle",
    "why": "an agent-review failure is in the implementer's fix loop (or blocked at its cap); trapping the session would force a merge or a dodge",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"feature-branch\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"StatusContext\", \"context\": \"agent-review\", \"state\": \"FAILURE\"}]}}"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-story-pr-not-linked-from-notion",
    "hook": "stop:pr-lifecycle",
    "why": "every story carries its own PR link from the moment the PR opens; a draft on a story branch with no recorded link sends the session to speckit-notion-sync pr",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"390-audit-history\", \"ahead\": 2, \"unpushed\": 0, \"blocked\": false, \"prLinked\": false, \"pr\": {\"number\": 12, \"state\": \"OPEN\", \"isDraft\": true, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "speckit-notion-sync pr 12"
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-ready-pr-without-the-in-review-label",
    "hook": "stop:pr-lifecycle",
    "why": "the owner watches GitHub for PRs in review; a ready PR without the `in review` label is invisible there",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"chore-notion-tool-names\", \"ahead\": 2, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 27, \"state\": \"OPEN\", \"isDraft\": false, \"labels\": [], \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "--add-label \"in review\""
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-draft-without-the-in-development-label",
    "hook": "stop:pr-lifecycle",
    "why": "every open PR shows its stage on GitHub; a draft is `in development`",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"chore-x\", \"ahead\": 1, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 28, \"state\": \"OPEN\", \"isDraft\": true, \"labels\": [], \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "--add-label \"in development\""
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-pr-without-its-type-label",
    "hook": "stop:pr-lifecycle",
    "why": "the owner filters PRs by type on GitHub; a fix(\u2026) PR must say bug",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"chore-x\", \"ahead\": 1, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 40, \"title\": \"fix(web): ST-9 x\", \"state\": \"OPEN\", \"isDraft\": true, \"labels\": [{\"name\": \"in development\"}], \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "--add-label \"bug\""
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-ready-pr-with-two-stage-labels",
    "hook": "stop:pr-lifecycle",
    "why": "an open PR carries exactly one stage label; PR #33 caught up by adding QA and kept in review, so GitHub showed two stages",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"467-skill-model-pins\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 33, \"title\": \"chore(harness): ST-467 pin a model to each spec-kit phase\", \"state\": \"OPEN\", \"isDraft\": false, \"labels\": [{\"name\": \"in review\"}, {\"name\": \"QA\"}, {\"name\": \"tooling\"}], \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "gh pr edit 33 --remove-label \"in review\"\\)"
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-draft-labelled-in-review",
    "hook": "stop:pr-lifecycle",
    "why": "a draft is planning or in development; in review on a draft shows a stage the PR has left or not reached",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"chore-x\", \"ahead\": 1, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 41, \"title\": \"feat(web): ST-9 x\", \"state\": \"OPEN\", \"isDraft\": true, \"labels\": [{\"name\": \"in review\"}, {\"name\": \"feature\"}], \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": []}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "--remove-label \"in review\" --add-label \"in development\""
    }
  }
]
