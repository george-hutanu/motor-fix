[
  {
    "id": "pr-lifecycle-never-blocks-twice-in-a-row",
    "hook": "stop:pr-lifecycle",
    "why": "stop_hook_active means the gate already refused this turn; refusing again loops forever, and Claude Code's contract forbids it",
    "payload": {
      "stop_hook_active": true
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "pr-lifecycle-fails-open-outside-a-repository",
    "hook": "stop:pr-lifecycle",
    "why": "a gate that cannot read the branch has nothing to judge; trapping the session would punish a broken environment, not unfinished work",
    "payload": {
      "cwd": "/"
    },
    "expect": {
      "exit": 0
    }
  },
  {
    "id": "pr-lifecycle-refuses-a-green-pr-the-tester-has-not-passed",
    "hook": "stop:pr-lifecycle",
    "why": "a session that ends on a green ready PR with no agent review skips the QA step; the gate sends it to the tester instead of to the merge",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"434-agent-pr-review\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}]}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "speckit-pr-test 21"
    }
  },
  {
    "id": "pr-lifecycle-treats-a-tested-green-pr-as-mergeable",
    "hook": "stop:pr-lifecycle",
    "why": "with agent-review success on the head the PR is mergeable, and leaving it unmerged is the unfinished task Constitution VII refuses",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"434-agent-pr-review\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"StatusContext\", \"context\": \"agent-review\", \"state\": \"SUCCESS\"}]}}"
    },
    "expect": {
      "exit": 2,
      "stderr": "Merge it"
    }
  },
  {
    "id": "pr-lifecycle-lets-the-fix-loop-own-a-failing-review",
    "hook": "stop:pr-lifecycle",
    "why": "an agent-review failure is in the implementer's fix loop (or blocked at its cap); trapping the session would force a merge or a dodge",
    "payload": {},
    "env": {
      "SPECKIT_PR_STATE": "{\"branch\": \"434-agent-pr-review\", \"ahead\": 3, \"unpushed\": 0, \"blocked\": false, \"pr\": {\"number\": 21, \"state\": \"OPEN\", \"isDraft\": false, \"mergeable\": \"MERGEABLE\", \"statusCheckRollup\": [{\"__typename\": \"CheckRun\", \"name\": \"checks\", \"conclusion\": \"SUCCESS\"}, {\"__typename\": \"StatusContext\", \"context\": \"agent-review\", \"state\": \"FAILURE\"}]}}"
    },
    "expect": {
      "exit": 0
    }
  }
