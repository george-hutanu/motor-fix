[
  {
    "id": "routes-a-large-review-to-fable",
    "hook": "pre:tool:agent-model",
    "why": "a 20-file diff is the review where a defect spans files, and the band above the ceiling is mechanical so it costs no round trip",
    "payload": {
      "tool_name": "Agent",
      "tool_input": {
        "subagent_type": "spec-reviewer",
        "prompt": "Review the feature against HEAD~1..HEAD"
      }
    },
    "expect": {
      "exit": 0,
      "stdout": "\"model\":\"fable\""
    },
    "env": {
      "SPECKIT_JEV": "0"
    },
    "fixture": {
      "commits": [
        {
          "files": {
            "README.md": "fixture\n"
          }
        },
        {
          "files": {
            "libs/domain/src/m00.ts": "export const m00 = 0;\n",
