{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "i18n",
  "projectType": "library",
  "sourceRoot": "libs/i18n/src",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.shared.ts",
        "{workspaceRoot}/apps/web/src/**/*",
        {
          "externalDependencies": [
            "vitest",
            "@angular/build",
            "@analogjs/vite-plugin-angular",
            "jsdom"
          ]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        }
      ],
      "options": {
        "buildTarget": "i18n:test-build:development",
        "isolate": true,
        "runner": "vitest",
        "runnerConfig": "libs/i18n/vitest.config.ts",
        "setupFiles": ["libs/i18n/src/test-setup.ts"],
        "tsConfig": "libs/i18n/tsconfig.spec.json"
      }
    },
    "test-build": {
      "configurations": {
        "development": {}
      },
      "executor": "@angular/build:application",
      "options": {
        "tsConfig": "libs/i18n/tsconfig.lib.json"
      }
    },
    "test:mutation": {},
    "typecheck": {
      "cache": true,
      "command": "ngc --noEmit -p libs/i18n/tsconfig.lib.json && tsc --noEmit -p libs/i18n/tsconfig.spec.json"
    }
  }
}
