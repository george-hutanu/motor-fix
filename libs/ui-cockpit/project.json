{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ui-cockpit",
  "prefix": "mf",
  "projectType": "library",
  "sourceRoot": "libs/ui-cockpit/src",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "ui-cockpit:test-build:development",
        "isolate": true,
        "runner": "vitest",
        "runnerConfig": "libs/ui-cockpit/vitest.config.ts",
        "setupFiles": ["libs/ui-cockpit/src/test-setup.ts"],
        "tsConfig": "libs/ui-cockpit/tsconfig.spec.json"
      }
    },
    "test-build": {
      "configurations": {
        "development": {}
      },
      "executor": "@angular/build:application",
      "options": {
        "tsConfig": "libs/ui-cockpit/tsconfig.lib.json"
      }
    },
    "test:mutation": {},
    "typecheck": {
      "cache": true,
      "command": "ngc --noEmit -p libs/ui-cockpit/tsconfig.lib.json && tsc --noEmit -p libs/ui-cockpit/tsconfig.spec.json"
    }
  }
}
