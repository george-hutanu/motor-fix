// catalogue module models — the brand list MotorFix keeps; garages only point
// at it.

// Rows are never deleted: a brand missing from the data file is inactive.
model Brand {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @unique
  name         String        @unique
  slug         String        @unique
  popularity   Int?
  roPossessive String?       @map("ro_possessive")
  active       Boolean       @default(true)
  // The generic 3D car shown for a brand with no licensed model.
  bodyStyle    BodyStyle     @default(saloon) @map("body_style")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  // The admin who last changed the brand; the loader leaves such a brand alone.
  // No foreign key: the ownership outlives the admin's account.
  updatedBy    String?       @map("updated_by") @db.Uuid
  garageBrands GarageBrand[]
  cars         Car[]
  prices       GaragePrice[]
  searchLogs   SearchLog[]
  models3d     CarModel3d[]

  @@index([active, popularity, name])
  @@map("brand")
}

enum BodyStyle {
  saloon
  hatchback
  suv
  crossover
  estate
  fastback

  @@map("body_style")
}

// The systems the 3D car can light, one part and one pin each in its file.
// Owned by the data file: the loader writes them at start.
model CarSystem {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  fuelTypes Fuel[]   @map("fuel_types")
  nameRo    String   @map("name_ro")
  nameEn    String   @map("name_en")
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("car_system")
}

// A licensed car model and the key of its 3D file in object storage. Owned by
// the data file: the loader writes them at start and deletes a withdrawn one.
model CarModel3d {
  id         String    @id @default(uuid()) @db.Uuid
  key        String    @unique
  brandId    String    @map("brand_id") @db.Uuid
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model      String
  fileKey    String    @unique @map("file_key")
  // Within the brand; 1 is the car shown when only the brand is picked.
  popularity Int
  fuel       Fuel
  bodyStyle  BodyStyle @map("body_style")
  // The licence record, kept once the licence is bought.
  licenceRef String?   @map("licence_ref")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([brandId, popularity])
  @@map("car_model_3d")
}

enum JobTypeStatus {
  approved
  pending
  rejected

  @@map("job_type_status")
}

// A job a garage can price. The shipped jobs load approved at start; a row
// added later is a proposal an admin decides. Rows are never deleted.
model JobType {
  id                 String           @id @default(uuid()) @db.Uuid
  key                String           @unique
  nameRo             String           @map("name_ro")
  nameEn             String           @map("name_en")
  status             JobTypeStatus    @default(pending)
  carSystem          String?          @map("car_system")
  rarActivity        String?          @map("rar_activity")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  prices             GaragePrice[]
  brandJobs          GarageBrandJob[]
  // The garage that proposed it while listing; null for the shipped jobs.
  proposedByGarageId String?          @map("proposed_by_garage_id") @db.Uuid
  proposedBy         Garage?          @relation(fields: [proposedByGarageId], references: [id], onDelete: SetNull)
  requestJobs        RequestJob[]
  // The admin's decision on a proposal; empty for the shipped jobs. The
  // reason is set only by a rejection (CHECK in the migration).
  decidedBy          String?          @map("decided_by") @db.Uuid
  decider            Account?         @relation("JobTypeDecider", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(3)
  rejectionReason    String?          @map("rejection_reason") @db.VarChar(500)

  @@index([proposedByGarageId])
  @@map("job_type")
}

// Romania's legal holidays, one row per day; two holidays on one day share
// the row, their names joined with " / ". Each year is added by a migration.
model PublicHoliday {
  day    DateTime @id @db.Date
  nameRo String   @map("name_ro")
  nameEn String   @map("name_en")

  @@map("public_holiday")
}
