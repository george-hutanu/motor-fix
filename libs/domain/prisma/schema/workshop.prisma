// workshop module models: the work on a confirmed booking. Only the workshop
// module writes them; the moves between stages are in
// src/workshop/transitions.ts.

enum JobStatus {
  to_do
  in_work
  paused
  done
  cancelled

  @@map("job_status")
}

model Job {
  id             String          @id @default(uuid()) @db.Uuid
  bookingId      String          @unique @map("booking_id") @db.Uuid
  garageId       String          @map("garage_id") @db.Uuid
  carId          String          @map("car_id") @db.Uuid
  driverId       String          @map("driver_id") @db.Uuid
  mechanicId     String?         @map("mechanic_id") @db.Uuid
  status         JobStatus       @default(to_do)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  pausedAt       DateTime?       @map("paused_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)
  handedOverAt   DateTime?       @map("handed_over_at") @db.Timestamptz(3)
  etaAt          DateTime?       @map("eta_at") @db.Timestamptz(3)
  finalPriceBani Int?            @map("final_price_bani")
  // Set by the first reception; a later one corrects the reading only.
  receivedAt     DateTime?       @map("received_at") @db.Timestamptz(3)
  odometerKm     Int?            @map("odometer_km")
  // Time in work, added on every move out of in_work.
  workedSeconds  Int             @default(0) @map("worked_seconds")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garage         Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  car            Car             @relation(fields: [carId], references: [id], onDelete: NoAction)
  driver         Account         @relation("JobDriver", fields: [driverId], references: [id], onDelete: Cascade)
  mechanic       Mechanic?       @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  steps          JobStep[]
  stages         JobStageEntry[]
  reviews        Review[]
  liveSessions   LiveSession[]
  repair         Repair?
  media          MediaItem[]

  @@index([garageId, createdAt(sort: Desc)])
  @@index([mechanicId])
  @@map("job")
}

model JobStep {
  id             String    @id @default(uuid()) @db.Uuid
  jobId          String    @map("job_id") @db.Uuid
  position       Int
  label          String
  // The words the driver sees, when they differ from the garage's own.
  customerLabel  String?   @map("customer_label")
  doneAt         DateTime? @map("done_at") @db.Timestamptz(3)
  // Who ticked it; cleared with done_at.
  doneById       String?   @map("done_by") @db.Uuid
  // The add's Idempotency-Key, so a resent add is the same step.
  idempotencyKey String?   @map("idempotency_key")
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  doneBy         Account?  @relation("JobStepDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([jobId, position])
  @@unique([jobId, idempotencyKey])
  @@map("job_step")
}

// When each stage began and who moved it: the tracker's history.
model JobStageEntry {
  id         String         @id @default(uuid()) @db.Uuid
  jobId      String         @map("job_id") @db.Uuid
  fromStatus JobStatus?     @map("from_status")
  toStatus   JobStatus      @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  AuditActorRole @map("actor_role")
  // The garage's own words for the driver.
  text       String?
  // The job's mechanic when the move was made.
  mechanicId String?        @map("mechanic_id") @db.Uuid
  // A pause the platform made when the mechanic started another job.
  auto       Boolean        @default(false)
  at         DateTime       @default(now()) @db.Timestamptz(3)
  job        Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor      Account?       @relation("JobStageActor", fields: [actorId], references: [id], onDelete: SetNull)
  mechanic   Mechanic?      @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  @@index([jobId, at])
  @@index([mechanicId])
  @@map("job_stage_entry")
}

// The places a confirmed booking holds: one row per working stretch it
// fills, each half-open [starts_at, ends_at). The exclusion constraints in the
// migration keep one mechanic, and one lift of a garage, to one booking at a
// time; a booking leaves its rows when it is cancelled, lapses or is missed.
model BookingSegment {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Exactly one of a booking and a time block holds the row (migration CHECK).
  bookingId   String?    @map("booking_id") @db.Uuid
  timeBlockId String?    @map("time_block_id") @db.Uuid
  garageId    String     @map("garage_id") @db.Uuid
  mechanicId  String?    @map("mechanic_id") @db.Uuid
  lift        Int?
  startsAt    DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime   @map("ends_at") @db.Timestamptz(3)
  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  timeBlock   TimeBlock? @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  garage      Garage     @relation(fields: [garageId], references: [id], onDelete: Cascade)
  mechanic    Mechanic?  @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([timeBlockId])
  @@index([garageId, startsAt])
  @@map("booking_segment")
}

// Time the garage holds on a mechanic, a lift or both, for a walk-in or a
// phone booking: no car, customer or job. Its segments, one per Bucharest day
// it touches, sit in booking_segment under the same exclusion constraints as
// a booking's. created_by and updated_by carry no foreign key: the row outlives
// the account that wrote it.
model TimeBlock {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId   String           @map("garage_id") @db.Uuid
  mechanicId String?          @map("mechanic_id") @db.Uuid
  lift       Int?
  startsAt   DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime         @map("ends_at") @db.Timestamptz(3)
  note       String?
  createdBy  String           @map("created_by") @db.Uuid
  updatedBy  String           @map("updated_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  garage     Garage           @relation(fields: [garageId], references: [id], onDelete: Cascade)
  mechanic   Mechanic?        @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  segments   BookingSegment[]

  @@index([garageId, startsAt])
  @@index([mechanicId])
  @@map("time_block")
}
