// cars module models: the driver's cars and their reminders.

enum Fuel {
  petrol
  diesel
  hybrid
  electric

  @@map("fuel")
}

// The limits are CHECKs in the migration as well; the 20-car limit is counted
// under the account row's lock, so a removed car frees a place.
model Car {
  id             String     @id @default(uuid()) @db.Uuid
  ownerId        String     @map("owner_id") @db.Uuid
  brandId        String     @map("brand_id") @db.Uuid
  model          String
  year           Int
  fuel           Fuel
  engine         String?
  odometerKm     Int        @map("odometer_km")
  // Private to the owner: never in an event, a log or another's answer.
  plate          String?
  itpUntil       DateTime?  @map("itp_until") @db.Date
  rcaUntil       DateTime?  @map("rca_until") @db.Date
  rovinietaUntil DateTime?  @map("rovinieta_until") @db.Date
  nextServiceKm  Int?       @map("next_service_km")
  idempotencyKey String     @map("idempotency_key")
  removedAt      DateTime?  @map("removed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  owner          Account    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brand          Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  reminders      Reminder[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("car")
}

enum ReminderKind {
  itp
  service
  rca
  rovinieta
  tyres_winter
  tyres_summer
  booking

  @@map("reminder_kind")
}

// One per car and kind, or one per booking. The flags are the guard that
// sends each stage once; a new due date resets them.
model Reminder {
  id         String       @id @default(uuid()) @db.Uuid
  accountId  String       @map("account_id") @db.Uuid
  carId      String?      @map("car_id") @db.Uuid
  bookingId  String?      @unique @map("booking_id") @db.Uuid
  kind       ReminderKind
  // None for tyres, which go on fixed days every year.
  dueOn      DateTime?    @map("due_on") @db.Date
  sent30     Boolean      @default(false) @map("sent_30")
  sent7      Boolean      @default(false) @map("sent_7")
  seasonYear Int?         @map("season_year")
  sentAt     DateTime?    @map("sent_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  car        Car?         @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, kind])
  @@index([accountId])
  @@index([dueOn])
  @@map("reminder")
}
