// cars module models: the driver's cars and their reminders.

enum Fuel {
  petrol
  diesel
  hybrid
  electric

  @@map("fuel")
}

// The limits are CHECKs in the migration as well; the 20-car limit is counted
// under the account row's lock, so a removed car frees a place.
model Car {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String            @map("owner_id") @db.Uuid
  brandId        String            @map("brand_id") @db.Uuid
  model          String
  year           Int
  fuel           Fuel
  engine         String?
  odometerKm     Int               @map("odometer_km")
  // Private to the owner: never in an event, a log or another's answer.
  plate          String?
  itpUntil       DateTime?         @map("itp_until") @db.Date
  rcaUntil       DateTime?         @map("rca_until") @db.Date
  rovinietaUntil DateTime?         @map("rovinieta_until") @db.Date
  nextServiceKm  Int?              @map("next_service_km")
  // Cleared when the car changes hands: the buyer never inherits it.
  idempotencyKey String?           @map("idempotency_key")
  removedAt      DateTime?         @map("removed_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  // The version an edit sends back: a save on an older one is refused.
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner          Account           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  reminders      Reminder[]
  readings       OdometerReading[]
  quoteRequests  QuoteRequest[]
  jobs           Job[]
  repairs        Repair[]
  transfers      CarTransfer[]
  ownerships     CarOwnership[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("car")
}

enum OdometerSource {
  driver
  reception
  repair

  @@map("odometer_source")
}

// The kilometres a car showed on a Bucharest day. The car's odometer_km is
// its newest reading, by day then creation time; km >= 0 is a CHECK in the
// migration. source_id names the reception or repair record, with no key, as
// each later source has its own table.
model OdometerReading {
  id        String         @id @default(uuid()) @db.Uuid
  carId     String         @map("car_id") @db.Uuid
  km        Int
  readOn    DateTime       @map("read_on") @db.Date
  source    OdometerSource
  sourceId  String?        @map("source_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  car       Car            @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId, readOn(sort: Desc), createdAt(sort: Desc)])
  @@map("odometer_reading")
}

enum ReminderKind {
  itp
  service
  rca
  rovinieta
  tyres_winter
  tyres_summer
  booking

  @@map("reminder_kind")
}

// One per car and kind, or one per booking. The flags are the guard that
// sends each stage once; a new due date resets them.
model Reminder {
  id         String       @id @default(uuid()) @db.Uuid
  accountId  String       @map("account_id") @db.Uuid
  carId      String?      @map("car_id") @db.Uuid
  bookingId  String?      @unique @map("booking_id") @db.Uuid
  kind       ReminderKind
  // None for tyres, which go on fixed days every year.
  dueOn      DateTime?    @map("due_on") @db.Date
  sent30     Boolean      @default(false) @map("sent_30")
  sent7      Boolean      @default(false) @map("sent_7")
  seasonYear Int?         @map("season_year")
  sentAt     DateTime?    @map("sent_at") @db.Timestamptz(3)
  // The next-service km a service row was estimated for; null for the rest.
  dueKm      Int?         @map("due_km")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  car        Car?         @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, kind])
  @@index([accountId])
  @@index([dueOn])
  @@map("reminder")
}

// A garage a driver keeps on their account; the time is the first save.
model SavedGarage {
  accountId String   @map("account_id") @db.Uuid
  garageId  String   @map("garage_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@id([accountId, garageId])
  @@map("saved_garage")
}

enum RepairSource {
  motorfix
  logged

  @@map("repair_source")
}

// A repair in a car's history: done through MotorFix (its job set) or logged
// by the owner by hand. `(source = 'motorfix') = (job_id IS NOT NULL)` is a
// CHECK in the migration. A soft-deleted repair is never shown.
// Who wrote a repair last: its driver, the named garage's owner, an admin.
enum RepairUpdater {
  driver
  owner
  admin

  @@map("repair_updater")
}

model Repair {
  id               String              @id @default(uuid()) @db.Uuid
  carId            String              @map("car_id") @db.Uuid
  jobId            String?             @unique @map("job_id") @db.Uuid
  source           RepairSource
  what             String
  garageName       String              @map("garage_name")
  garageId         String?             @map("garage_id") @db.Uuid
  doneOn           DateTime            @map("done_on") @db.Date
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  // A reading and an amount the driver or a correction gave; none when not.
  odometerKm       Int?                @map("odometer_km")
  costBani         Int?                @map("cost_bani")
  // The driver's choice to show the repair to the garage it names.
  sharedWithGarage Boolean             @default(false) @map("shared_with_garage")
  sharedAt         DateTime?           @map("shared_at") @db.Timestamptz(3)
  // The version a correction sends back, and its last writer.
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?             @map("updated_by") @db.Uuid
  updatedByRole    RepairUpdater?      @map("updated_by_role")
  updater          Account?            @relation("RepairUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  car              Car                 @relation(fields: [carId], references: [id], onDelete: Cascade)
  job              Job?                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  garage           Garage?             @relation(fields: [garageId], references: [id], onDelete: SetNull)
  transfers        CarTransferRepair[]

  @@index([carId, doneOn(sort: Desc), createdAt(sort: Desc)])
  @@map("repair")
}

enum CarTransferStatus {
  sent
  accepted
  cancelled
  expired

  @@map("car_transfer_status")
}

// A car handed to a buyer by a link. Only the token's hash is stored; the
// phone is E.164 and never leaves this row. A car has at most one `sent`
// transfer (a partial unique index), and `expires_at > sent_at` and the
// phone's shape are CHECKs in the migration.
model CarTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  carId           String              @map("car_id") @db.Uuid
  sellerId        String              @map("seller_id") @db.Uuid
  buyerPhone      String              @map("buyer_phone")
  tokenHash       String              @unique @map("token_hash")
  status          CarTransferStatus   @default(sent)
  sentAt          DateTime            @default(now()) @map("sent_at") @db.Timestamptz(3)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(3)
  buyerId         String?             @map("buyer_id") @db.Uuid
  saleDate        DateTime?           @map("sale_date") @db.Date
  car             Car                 @relation(fields: [carId], references: [id], onDelete: Cascade)
  seller          Account             @relation("TransferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer           Account?            @relation("TransferBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  repairs         CarTransferRepair[]
  // The buyer's ownership this transfer opened, once accepted.
  openedOwnership CarOwnership[]

  @@index([status, expiresAt])
  @@index([sellerId])
  @@map("car_transfer")
}

// A repair the seller ticked to pass on with the car.
model CarTransferRepair {
  transferId String      @map("transfer_id") @db.Uuid
  repairId   String      @map("repair_id") @db.Uuid
  transfer   CarTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  repair     Repair      @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@id([transferId, repairId])
  @@map("car_transfer_repair")
}

enum CarOwnershipAccess {
  owner
  former_owner_read_only

  @@map("car_ownership_access")
}

// Who held a car, from which day to which. The open row (no to_date) names
// car.owner_id; a partial unique index keeps one open row per car, and the
// CHECKs in the migration tie access, to_date and closed_at together.
// opened_at and closed_at are the instants that cut the logged repairs.
model CarOwnership {
  id         String             @id @default(uuid()) @db.Uuid
  carId      String             @map("car_id") @db.Uuid
  accountId  String             @map("account_id") @db.Uuid
  access     CarOwnershipAccess
  fromDate   DateTime           @map("from_date") @db.Date
  toDate     DateTime?          @map("to_date") @db.Date
  // The transfer that opened this row; none for a car added by hand.
  transferId String?            @map("transfer_id") @db.Uuid
  openedAt   DateTime           @map("opened_at") @db.Timestamptz(3)
  closedAt   DateTime?          @map("closed_at") @db.Timestamptz(3)
  car        Car                @relation(fields: [carId], references: [id], onDelete: Cascade)
  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer   CarTransfer?       @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([accountId, toDate(sort: Desc), closedAt(sort: Desc)])
  @@index([carId, accountId])
  @@map("car_ownership")
}
