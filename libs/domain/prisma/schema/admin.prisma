// admin module models

// One row per rule the whole platform follows. The value is JSON of the
// default's type, so a rule with a number or a list needs no new column.
model PlatformRule {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @unique
  value             Json
  defaultValue      Json      @map("default_value")
  requiresTwoAdmins Boolean   @default(false) @map("requires_two_admins")
  // No foreign key: the last change outlives the account, as the audit does.
  updatedBy         String?   @map("updated_by") @db.Uuid
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(3)

  @@map("platform_rule")
}

enum PlatformRuleChangeStatus {
  requested
  approved
  refused
  cancelled

  @@map("platform_rule_change_status")
}

// An admin's request to switch off a rule that needs a second admin, and how
// it ended. One waits per rule at most (a partial unique index in the
// migration). Ids without foreign keys and names kept at write time: the
// request outlives the accounts, as the audit does.
model PlatformRuleChange {
  id              String                   @id @default(uuid()) @db.Uuid
  ruleKey         String                   @map("rule_key")
  oldValue        Json                     @map("old_value")
  newValue        Json                     @map("new_value")
  reason          String
  status          PlatformRuleChangeStatus @default(requested)
  requestedBy     String                   @map("requested_by") @db.Uuid
  requestedByName String                   @map("requested_by_name")
  requestedAt     DateTime                 @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedBy       String?                  @map("decided_by") @db.Uuid
  decidedByName   String?                  @map("decided_by_name")
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(3)

  @@index([ruleKey, requestedAt(sort: Desc)])
  @@map("platform_rule_change")
}

enum StatusTileKey {
  api
  search
  maps
  email
  notifications
  backup

  @@map("status_tile_key")
}

enum StatusTileState {
  green
  amber
  red

  @@map("status_tile_state")
}

// The admin dashboard's service tiles, written only by the worker's checks.
// A state changes on two agreeing checks: the first differing one waits in
// pending_state until the next confirms or drops it.
model StatusTile {
  key          StatusTileKey    @id
  state        StatusTileState
  since        DateTime         @db.Timestamptz(3)
  detail       Json             @default("{}")
  checkedAt    DateTime         @map("checked_at") @db.Timestamptz(3)
  pendingState StatusTileState? @map("pending_state")
  pendingSince DateTime?        @map("pending_since") @db.Timestamptz(3)

  @@map("status_tile")
}

enum SystemLogKind {
  status_changed
  check_failed
  job_failed
  service_error
  server_error
  backup_completed
  backup_failed
  deploy

  @@map("system_log_kind")
}

enum SystemLogSource {
  api
  search
  maps
  email
  notifications
  backup
  worker
  webrtc
  identity
  storage

  @@map("system_log_source")
}

enum SystemLogSeverity {
  info
  warning
  error

  @@map("system_log_severity")
}

// The System status log: what the platform did and what went wrong, grouped
// per kind, source, fingerprint and minute. Kept 90 days.
model SystemLogEntry {
  id          String            @id @default(uuid()) @db.Uuid
  at          DateTime          @db.Timestamptz(3)
  minute      DateTime          @db.Timestamptz(3)
  kind        SystemLogKind
  source      SystemLogSource
  severity    SystemLogSeverity
  fingerprint String
  message     String
  context     Json              @default("{}")
  count       Int               @default(1)

  @@unique([kind, source, fingerprint, minute], map: "system_log_entry_group_key")
  @@index([at(sort: Desc)], map: "system_log_entry_at_idx")
  @@index([kind, at], map: "system_log_entry_kind_at_idx")
  @@index([message(ops: raw("gin_trgm_ops"))], map: "system_log_entry_message_trgm_idx", type: Gin)
  @@map("system_log_entry")
}
