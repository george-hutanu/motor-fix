// assistants module models

// One per account and assistant client (the token's azp), created at the
// first call after consent. Never deleted: revocation sets revoked_at.
model AssistantGrant {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String                  @map("account_id") @db.Uuid
  account       Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId      String                  @map("client_id")
  clientName    String                  @map("client_name")
  canRead       Boolean                 @map("can_read")
  canAct        Boolean                 @map("can_act")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime                @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?               @map("revoked_at") @db.Timestamptz(3)
  revokedBy     String?                 @map("revoked_by")
  revokeReason  String?                 @map("revoke_reason")
  confirmations AssistantConfirmation[]
  approvals     AssistantApproval[]

  // Also serves look-ups by account: account_id leads the index.
  @@unique([accountId, clientId])
  @@map("assistant_grant")
}

// The single-use code the identity server exchanges for an id token: only
// its sha256 is kept, good for 60 seconds.
model AssistantSignInCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash    String    @unique @map("code_hash")
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId    String    @map("client_id")
  nonce       String
  redirectUri String    @map("redirect_uri")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("assistant_sign_in_code")
}

enum AssistantConfirmationStatus {
  waiting
  done
  failed
  refused
  expired
  void

  @@map("assistant_confirmation_status")
}

// An acting tool's call waiting for the person's yes: only the hash of the
// arguments is kept, never the summary or the arguments themselves. Its id
// is the idempotency key of the run; expiry is judged at the next call.
model AssistantConfirmation {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantId   String                      @map("grant_id") @db.Uuid
  grant     AssistantGrant              @relation(fields: [grantId], references: [id], onDelete: Cascade)
  accountId String                      @map("account_id") @db.Uuid
  account   Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tool      String
  argsHash  String                      @map("args_hash")
  status    AssistantConfirmationStatus @default(waiting)
  expiresAt DateTime                    @map("expires_at") @db.Timestamptz(3)
  outcome   Json?
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime?                   @map("decided_at") @db.Timestamptz(3)

  @@index([grantId, status])
  @@index([accountId, status])
  @@map("assistant_confirmation")
}

enum AssistantApprovalKind {
  book
  move
  cancel

  @@map("assistant_approval_kind")
}

enum AssistantApprovalStatus {
  pending
  approved
  refused
  expired
  failed

  @@map("assistant_approval_status")
}

// An acting tool's call the person approves in the app after the yes: the
// arguments and the summary are kept to run and show it. Its id is the
// idempotency key of the run; written when saved and once when decided.
model AssistantApproval {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantId   String                  @map("grant_id") @db.Uuid
  grant     AssistantGrant          @relation(fields: [grantId], references: [id], onDelete: Cascade)
  accountId String                  @map("account_id") @db.Uuid
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tool      String
  kind      AssistantApprovalKind
  summary   String
  arguments Json
  editable  String[]
  status    AssistantApprovalStatus @default(pending)
  expiresAt DateTime                @map("expires_at") @db.Timestamptz(3)
  outcome   Json?
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime?               @map("decided_at") @db.Timestamptz(3)

  @@index([accountId, status])
  @@index([grantId, status])
  @@index([status, expiresAt])
  @@map("assistant_approval")
}
