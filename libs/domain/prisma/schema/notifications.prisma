// notifications module models

enum NotificationChannel {
  in_app
  email
  push
  sms
  whatsapp

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  held
  sent
  failed

  @@map("notification_status")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  // A catalogue type; the catalogue lives in code, so this is not an enum.
  kind              String
  subjectId         String?             @map("subject_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus
  eventId           String              @map("event_id")
  params            Json                @default("{}")
  sendAfter         DateTime?           @map("send_after") @db.Timestamptz(3)
  groupLeaderId     String?             @map("group_leader_id") @db.Uuid
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(3)
  fallbackOf        String?             @map("fallback_of") @db.Uuid
  failure           String?
  providerMessageId String?             @map("provider_message_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupLeader       Notification?       @relation("NotificationGroup", fields: [groupLeaderId], references: [id], onDelete: SetNull)
  grouped           Notification[]      @relation("NotificationGroup")
  fallbackFrom      Notification?       @relation("NotificationFallback", fields: [fallbackOf], references: [id], onDelete: SetNull)
  fallbacks         Notification[]      @relation("NotificationFallback")

  @@unique([kind, accountId, channel, eventId])
  @@index([accountId, createdAt])
  @@index([kind, accountId, channel, createdAt])
  @@index([providerMessageId])
  @@index([groupLeaderId])
  @@index([fallbackOf])
  @@map("notification")
}

// A person's choice for one type: a driver type has one row (its chosen
// channel), any other type one row per channel, with the garage for staff.
// No unique index: a driver row is unique per type whatever its channel, a
// staff row per channel, which one index cannot say; the save's per-account
// lock keeps both.
model NotificationPreference {
  id                 String              @id @default(uuid()) @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  garageId           String?             @map("garage_id") @db.Uuid
  type               String
  channel            NotificationChannel
  enabled            Boolean
  // NEWS only: the driver's consent, kept when it is withdrawn.
  consentGivenAt     DateTime?           @map("consent_given_at") @db.Timestamptz(3)
  consentTextVersion String?             @map("consent_text_version")
  consentSource      String?             @map("consent_source")
  withdrawnAt        DateTime?           @map("withdrawn_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  garage             Garage?             @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@index([garageId])
  @@map("notification_preference")
}

// The SMS a driver was sent in one calendar month (Europe/Bucharest); a new
// month is a new row, so nothing resets it.
model SmsCounter {
  accountId String  @map("account_id") @db.Uuid
  month     String
  sentCount Int     @default(0) @map("sent_count")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, month])
  @@map("sms_counter")
}

// One news e-mail a calendar month (Europe/Bucharest): the month is the key,
// so a second send, or two at once, cannot take it twice.
model NewsSend {
  month      String   @id
  sentById   String   @map("sent_by_id") @db.Uuid
  recipients Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("news_send")
}

// One browser that allowed push for one account. The endpoint is unique: a
// browser belongs to the account that saved it last.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("push_subscription")
}
