// garages module models — only what links an account to a garage; the
// garages module extends Garage when it arrives.

enum GarageMemberRole {
  owner
  receptionist

  @@map("garage_member_role")
}

// Public when, and only when, `approved`.
enum GarageStatus {
  draft
  approved
  suspended

  @@map("garage_status")
}

enum BusinessKind {
  company
  pfa
  ii
  mobile

  @@map("business_kind")
}

// How a mobile service is registered; only a mobile one has it.
enum MobileLegalForm {
  pfa
  company

  @@map("mobile_legal_form")
}

model Garage {
  id                         String                                 @id @default(uuid()) @db.Uuid
  // name, address, seatAddress and cityName: a trigger in the migration
  // stores the comma letters ș ț for the cedilla ones ş ţ, whoever writes.
  name                       String
  slug                       String                                 @unique
  status                     GarageStatus                           @default(draft)
  approvedAt                 DateTime?                              @map("approved_at") @db.Timestamptz(3)
  // The Bucharest day of the latest check: written by every approval and by
  // every valid re-check.
  lastCheckedOn              DateTime?                              @map("last_checked_on") @db.Date
  createdAt                  DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  // When the garage closed; NULL while open. The closure story writes it; retention reads it.
  closedAt                   DateTime?                              @map("closed_at") @db.Timestamptz(3)
  verificationFiles          VerificationFile[]
  rechecks                   Recheck[]
  reports                    GarageReport[]
  savedBy                    SavedGarage[]
  members                    GarageMember[]
  mechanics                  Mechanic[]
  notificationPreferences    NotificationPreference[]
  features                   GarageFeature[]
  survey                     GarageSurvey?
  invites                    StaffInvite[]
  // CHECKs in the migration: at most 140 and 60 characters, never blank.
  brandNote                  String?                                @map("brand_note")
  refusalPhrase              String?                                @map("refusal_phrase")
  brands                     GarageBrand[]
  // rar_activity codes the RAR authorisation covers; the activities check
  // writes them.
  rarActivities              String[]                               @default([]) @map("rar_activities")
  // The hourly labour range, in bani; both set when the listing is sent.
  labourFromBani             Int?                                   @map("labour_from_bani")
  labourToBani               Int?                                   @map("labour_to_bani")
  // Written by the reviews; until then null and 0. CHECKs in the migration:
  // 1.0 to 5.0, a count of 0 or more, and a rating exactly when reviewed.
  rating                     Decimal?                               @db.Decimal(2, 1)
  reviewCount                Int                                    @default(0) @map("review_count")
  prices                     GaragePrice[]
  // WeeklyHours from contracts' garage-hours; {} until the listing is sent.
  hours                      Json                                   @default("{}")
  // Lifts numbered 1..liftCount on a confirmed booking; 0 schedules none.
  liftCount                  Int                                    @default(0) @map("lift_count")
  closedDays                 GarageClosedDay[]
  facilities                 GarageFacility[]
  // At most 200 characters, never blank (a CHECK in the migration); public.
  facilitiesNote             String?                                @map("facilities_note")
  // CHECKs in the migration: +40 and nine digits; 1 to 160 characters; a
  // legal form only for a mobile service. Never in a public read.
  phone                      String?
  knownFor                   String?                                @map("known_for")
  businessKind               BusinessKind?                          @map("business_kind")
  // The fiscal code, 2 to 10 digits (a CHECK in the migration); the admin
  // reads it in the verification file. Never in a public read.
  cui                        String?                                @db.VarChar(10)
  mobileLegalForm            MobileLegalForm?                       @map("mobile_legal_form")
  proposedJobs               JobType[]
  address                    String?                                @db.VarChar(200)
  // A mobile mechanic's registered seat: checked by the admin, never public.
  seatAddress                String?                                @map("seat_address") @db.VarChar(200)
  latitude                   Float?
  longitude                  Float?
  // latitude and longitude as a geography for the area reads, kept by a
  // trigger in the migration; NULL when either is. Read only in raw SQL.
  position                   Unsupported("geography(Point, 4326)")?
  // The town of the address or seat, for the admin's figures by city; admin
  // only, as the seat is. CHECKs in the migration: a slug key, both or neither.
  cityKey                    String?                                @map("city_key") @db.VarChar(80)
  cityName                   String?                                @map("city_name") @db.VarChar(80)
  // When the nightly placing last asked the look-up for this garage's city.
  cityLookedUpAt             DateTime?                              @map("city_looked_up_at") @db.Timestamptz(3)
  serviceRadiusKm            Int?                                   @map("service_radius_km") @db.SmallInt
  photos                     GaragePhoto[]
  // The payment methods step 5 ticks; at least one is the step's rule, not
  // the row's: an unsent garage has none.
  paymentCash                Boolean                                @default(false) @map("payment_cash")
  paymentCard                Boolean                                @default(false) @map("payment_card")
  paymentTransfer            Boolean                                @default(false) @map("payment_transfer")
  // CHECKs in the migration: a price exactly when paid, whole lei from 1 to
  // 2,000. Meaningful only while the garage lists the courtesy car.
  courtesyCarPaid            Boolean                                @default(false) @map("courtesy_car_paid")
  courtesyCarPricePerDayBani Int?                                   @map("courtesy_car_price_per_day_bani")
  requestRecipients          RequestRecipient[]
  quotes                     Quote[]
  bookings                   Booking[]
  bookingSegments            BookingSegment[]
  jobs                       Job[]
  reviews                    Review[]
  liveSessions               LiveSession[]
  media                      MediaItem[]
  reviewReplies              ReviewReply[]
  responseStats              GarageResponseStats?
  dailyFigures               GarageDailyFigures[]
  suspensions                GarageSuspension[]
  documentCycle              DocumentCycle?

  @@index([cityKey])
  @@index([position], map: "garage_position_idx", type: Gist)
  // The file read names the other garages holding the same CUI.
  @@index([cui])
  // garage_list_order_idx, a partial index the migration writes: the order of
  // the brand-first list (rating DESC NULLS LAST, review_count DESC, name, id)
  // over the approved garages, which Prisma cannot express.
  @@map("garage")
}

// The gallery, written when the listing is sent; the files stay under the
// draft's storage keys. CHECKs in the migration: a position from 0, the
// cover; a width and height above 0 when the photo was processed; a
// ThumbHash of at most 64 characters. variantPath is g/<draft id>/<digest>,
// the public path of the photo's responsive copies.
model GaragePhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId    String   @map("garage_id") @db.Uuid
  fileKey     String   @unique @map("file_key")
  position    Int
  width       Int?
  height      Int?
  variantPath String?  @unique @map("variant_path")
  thumbhash   String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  garage      Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([garageId, position])
  @@map("garage_photo")
}

// The garage's own closed days; a legal holiday is closed through the
// calendar alone and never has a row. CHECK in the migration: a note of at
// most 80 characters.
model GarageClosedDay {
  garageId String   @map("garage_id") @db.Uuid
  day      DateTime @db.Date
  note     String?
  garage   Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@id([garageId, day])
  @@map("garage_closed_day")
}

enum GarageFacilityKind {
  courtesy_car
  pickup_dropoff
  waiting_area

  @@map("garage_facility_kind")
}

enum GarageFacilityStatus {
  listed

  @@map("garage_facility_status")
}

model GarageFacility {
  garageId  String               @map("garage_id") @db.Uuid
  facility  GarageFacilityKind
  status    GarageFacilityStatus @default(listed)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  garage    Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@id([garageId, facility])
  @@map("garage_facility")
}

model GarageMember {
  garageId  String           @map("garage_id") @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  role      GarageMemberRole
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  garage    Garage           @relation(fields: [garageId], references: [id], onDelete: Cascade)
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([garageId, accountId])
  @@unique([accountId, role])
  @@map("garage_member")
}

// A card the owner names when listing has no account until its invite is
// accepted. CHECKs in the migration: a name of 2 to 80 characters (an
// invite's), a speciality of at most 80.
model Mechanic {
  id                  String           @id @default(uuid()) @db.Uuid
  garageId            String           @map("garage_id") @db.Uuid
  accountId           String?          @unique @map("account_id") @db.Uuid
  name                String
  // The specialties joined with ", ", kept for the readers of one line.
  speciality          String?
  // The card's own fields, the owner's to write (migration CHECKs).
  roleTitle           String?          @map("role_title")
  specialties         String[]         @default([])
  certifications      String[]         @default([])
  years               Int?
  // The garage's works_on brands the mechanic works on; no foreign key.
  brandIds            String[]         @default([]) @map("brand_ids") @db.Uuid
  // The garage owner's own row: never removed, created with the garage.
  isOwner             Boolean          @default(false) @map("is_owner")
  // One stretch a weekday at most; null keeps the garage's weekdays.
  workingHours        Json?            @map("working_hours")
  // Whether the Saturday stretch counts.
  worksSaturdays      Boolean          @default(false) @map("works_saturdays")
  onProfile           Boolean          @default(false) @map("on_profile")
  canMoveBookings     Boolean          @default(false) @map("can_move_bookings")
  canAnswerQuotes     Boolean          @default(false) @map("can_answer_quotes")
  canRecordFinalPrice Boolean          @default(false) @map("can_record_final_price")
  // Over the published reviews naming the mechanic, at every garage; the
  // garage's rules (migration CHECKs).
  rating              Decimal?         @db.Decimal(2, 1)
  reviewCount         Int              @default(0) @map("review_count")
  // Set when the account was deleted: the card stays for its reviews and
  // bookings, and leaves the team list.
  removedAt           DateTime?        @map("removed_at") @db.Timestamptz(3)
  garage              Garage           @relation(fields: [garageId], references: [id], onDelete: Cascade)
  account             Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  bookingSegments     BookingSegment[]
  invites             StaffInvite[]
  jobs                Job[]
  stageEntries        JobStageEntry[]
  reviews             Review[]
  daysOff             MechanicDayOff[]

  @@index([garageId])
  @@map("mechanic")
}

// A day or a range a mechanic is off, as the owner entered it; no two of one
// mechanic overlap (a service rule under the mechanic row's lock). Past rows
// stay for the history.
model MechanicDayOff {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mechanicId String   @map("mechanic_id") @db.Uuid
  firstDay   DateTime @map("first_day") @db.Date
  lastDay    DateTime @map("last_day") @db.Date
  note       String?
  // The account that added it; no foreign key, so the row outlives it.
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([mechanicId, lastDay])
  @@map("mechanic_day_off")
}

// A switch the garage turns off for itself (`whatsapp`); a missing row is on.
model GarageFeature {
  garageId String  @map("garage_id") @db.Uuid
  key      String
  enabled  Boolean
  garage   Garage  @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@id([garageId, key])
  @@map("garage_feature")
}

// The sign-up survey's five answers, one row per garage, kept for the reports
// on where owners heard of the product. CHECKs in the migration hold the codes.
model GarageSurvey {
  garageId       String   @id @map("garage_id") @db.Uuid
  mechanicsCount String   @map("mechanics_count")
  liftsCount     String   @map("lifts_count")
  wantsLiveMedia Boolean  @map("wants_live_media")
  wantsDaySheets Boolean  @map("wants_day_sheets")
  foundVia       String   @map("found_via")
  answeredAt     DateTime @default(now()) @map("answered_at") @db.Timestamptz(3)
  garage         Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@map("garage_survey")
}

enum StaffInviteKind {
  mechanic
  receptionist

  @@map("staff_invite_kind")
}

// `expired` is never written: a sent invite past `expiresAt` is expired.
enum StaffInviteStatus {
  sent
  accepted
  revoked

  @@map("staff_invite_status")
}

// An owner's invitation to an e-mail address; only the token's hash is kept,
// and a resend replaces it.
model StaffInvite {
  id                  String            @id @default(uuid()) @db.Uuid
  garageId            String            @map("garage_id") @db.Uuid
  kind                StaffInviteKind
  name                String
  email               String?
  // E.164; exactly one of email and phone is set (`staff_invite_one_address`).
  phone               String?
  // The card the invite was sent for; accepting it links the account to it.
  mechanicId          String?           @map("mechanic_id") @db.Uuid
  canMoveBookings     Boolean           @default(false) @map("can_move_bookings")
  canAnswerQuotes     Boolean           @default(false) @map("can_answer_quotes")
  canRecordFinalPrice Boolean           @default(false) @map("can_record_final_price")
  tokenHash           String            @unique @map("token_hash")
  status              StaffInviteStatus @default(sent)
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  garage              Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  mechanic            Mechanic?         @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  @@index([garageId, email])
  @@index([mechanicId])
  @@map("staff_invite")
}

enum GarageBrandStance {
  works_on
  does_not_take

  @@map("garage_brand_stance")
}

// A garage's answer for one brand; no row is `unstated`. The migration's
// `garage_brand_fuel_check` refuses a fuel tick on a `does_not_take` row.
model GarageBrand {
  garageId  String            @map("garage_id") @db.Uuid
  brandId   String            @map("brand_id") @db.Uuid
  stance    GarageBrandStance
  petrol    Boolean           @default(true)
  diesel    Boolean           @default(true)
  hybrid    Boolean           @default(true)
  electric  Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  garage    Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  brand     Brand             @relation(fields: [brandId], references: [id])
  jobs      GarageBrandJob[]

  @@id([garageId, brandId])
  @@index([brandId])
  @@map("garage_brand")
}

// A job type the garage does for a brand it works on; the row is the tick.
model GarageBrandJob {
  garageId    String      @map("garage_id") @db.Uuid
  brandId     String      @map("brand_id") @db.Uuid
  jobTypeId   String      @map("job_type_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  garageBrand GarageBrand @relation(fields: [garageId, brandId], references: [garageId, brandId], onDelete: Cascade)
  jobType     JobType     @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)

  @@id([garageId, brandId, jobTypeId])
  @@index([jobTypeId])
  @@map("garage_brand_job")
}

// A garage's price range for one job, in bani; no brand is the default range.
// One row per garage, job and brand, an empty brand included: the migration's
// `garage_price_one_range` index is NULLS NOT DISTINCT, which Prisma cannot
// express, so the schema carries no @@unique for it.
model GaragePrice {
  id              String   @id @default(uuid()) @db.Uuid
  garageId        String   @map("garage_id") @db.Uuid
  jobTypeId       String   @map("job_type_id") @db.Uuid
  brandId         String?  @map("brand_id") @db.Uuid
  fromBani        Int      @map("from_bani")
  toBani          Int?     @map("to_bani")
  durationMinutes Int?     @map("duration_minutes")
  visible         Boolean  @default(true)
  position        Int
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  // The account that last saved the row; no foreign key, the history keeps actors.
  updatedBy       String   @map("updated_by") @db.Uuid
  garage          Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  jobType         JobType  @relation(fields: [jobTypeId], references: [id])
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([jobTypeId])
  @@index([brandId])
  @@map("garage_price")
}

enum VerificationFileStatus {
  submitted
  in_review
  approved
  more_requested
  rejected

  @@map("verification_file_status")
}

// A garage's request to be approved. At most one file per garage is live
// (submitted, in review or approved): a partial unique index the migration
// writes by hand. The actors are kept without foreign keys, as the history
// keeps them; a null `decidedBy` is the system.
model VerificationFile {
  id               String                    @id @default(uuid()) @db.Uuid
  garageId         String                    @map("garage_id") @db.Uuid
  status           VerificationFileStatus    @default(submitted)
  openedBy         String?                   @map("opened_by") @db.Uuid
  openedAt         DateTime?                 @map("opened_at") @db.Timestamptz(3)
  decidedBy        String?                   @map("decided_by") @db.Uuid
  decidedAt        DateTime?                 @map("decided_at") @db.Timestamptz(3)
  reopenedBy       String?                   @map("reopened_by") @db.Uuid
  reopenedAt       DateTime?                 @map("reopened_at") @db.Timestamptz(3)
  previousFileId   String?                   @unique @map("previous_file_id") @db.Uuid
  reasonCode       String?                   @map("reason_code")
  reasonNote       String?                   @map("reason_note")
  // What a request for more asks for; empty for any other decision.
  requestedItems   String[]                  @default([]) @map("requested_items")
  declaredAt       DateTime?                 @map("declared_at") @db.Timestamptz(3)
  declaredByName   String?                   @map("declared_by_name")
  // The garage's RAR authorisation number, normalised; an admin corrects it.
  rarNumber        String?                   @map("rar_number") @db.VarChar(40)
  // The other listings holding the same CUI at the send, their names
  // joined by ", "; a fact for the admin, never a refusal.
  cuiWarning       String?                   @map("cui_warning")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  // The latest sending: set at submitting, reset at a resending or a
  // reopening. The admins' queue waits from it.
  submittedAt      DateTime                  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  garage           Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  previousFile     VerificationFile?         @relation("follows", fields: [previousFileId], references: [id], onDelete: SetNull)
  nextFile         VerificationFile?         @relation("follows")
  checks           VerificationCheck[]
  reopenReason     VerificationReopenReason? @map("reopen_reason")
  reports          GarageReport[]
  documents        LegalDocument[]
  completionCopies ListingDraft[]

  @@index([garageId, createdAt])
  @@index([status, submittedAt])
  @@map("verification_file")
}

enum VerificationReopenReason {
  garage_report

  @@map("verification_reopen_reason")
}

// An admin's decision closes every open report of the file at once.
enum GarageReportStatus {
  open
  unfounded
  confirmed

  @@map("garage_report_status")
}

// A driver's report of a garage, attached to the garage's newest verification
// file. SQL only, in the migration: the text's 20 to 1,000 characters and one
// open report per reporter and garage. A decided report carries who decided,
// when, and the admin's note or the reason the garage was given.
model GarageReport {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId           String             @map("garage_id") @db.Uuid
  verificationFileId String             @map("verification_file_id") @db.Uuid
  reporterId         String             @map("reporter_id") @db.Uuid
  text               String
  status             GarageReportStatus @default(open)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedBy          String?            @map("decided_by") @db.Uuid
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote       String?            @map("decision_note")
  garage             Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  verificationFile   VerificationFile   @relation(fields: [verificationFileId], references: [id], onDelete: Cascade)
  reporter           Account            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([verificationFileId])
  @@index([reporterId, createdAt])
  @@map("garage_report")
}

enum GarageSuspensionCause {
  recheck_failed
  documents_overdue
  admin
  report_confirmed

  @@map("garage_suspension_cause")
}

// A garage taken off the map. Open while untilTime is empty; the migration
// holds the reason's 1-200 characters and one open suspension per garage.
model GarageSuspension {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId    String                @map("garage_id") @db.Uuid
  cause       GarageSuspensionCause
  reason      String
  fromTime    DateTime              @map("from_time") @db.Timestamptz(3)
  untilTime   DateTime?             @map("until_time") @db.Timestamptz(3)
  // The admin's account; empty when MotorFix itself suspended.
  suspendedBy String?               @map("suspended_by") @db.Uuid
  // The admin who put the garage back on the map; empty while open.
  liftedBy    String?               @map("lifted_by") @db.Uuid
  // The trimmed lift note, 1-1,000 code points, or null.
  liftNote    String?               @map("lift_note")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  garage      Garage                @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, fromTime])
  @@map("garage_suspension")
}

// A legal document sent with a listing: its pages are storage keys in page
// order. The migration holds the 1-10 pages check.
model LegalDocument {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationFileId String           @map("verification_file_id") @db.Uuid
  kind               String
  pages              String[]
  issuedOn           DateTime?        @map("issued_on") @db.Date
  // valid, in_review (a yearly upload waiting for an admin) or refused: a
  // CHECK in the migration. A listing's documents are valid from the start.
  status             String           @default("valid")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set when a resend or an accepted yearly upload brought a newer valid row
  // of the kind. Per file and kind, one valid row is current and one at most
  // is in review: the partial unique indexes legal_document_one_valid and
  // legal_document_one_in_review, in SQL.
  replacedAt         DateTime?        @map("replaced_at") @db.Timestamptz(3)
  // The admin's decision on a yearly upload; empty for a listing's documents.
  // The reason is documents or other, a CHECK in the migration.
  decidedBy          String?          @map("decided_by") @db.Uuid
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(3)
  refusalReason      String?          @map("refusal_reason")
  refusalNote        String?          @map("refusal_note")
  verificationFile   VerificationFile @relation(fields: [verificationFileId], references: [id], onDelete: Cascade)

  @@index([verificationFileId])
  @@index([status, createdAt])
  @@map("legal_document")
}

// When an approved garage owes its documents again: a Europe/Bucharest day a
// year after the last acceptance. The state is due or overdue (a CHECK in the
// migration); the grace runs from the day after the due date and is set with
// overdue. The reminder marks are each set once per cycle; an acceptance of
// both documents resets the cycle and clears them.
model DocumentCycle {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garageId     String    @unique @map("garage_id") @db.Uuid
  dueOn        DateTime  @map("due_on") @db.Date
  state        String    @default("due")
  graceUntil   DateTime? @map("grace_until") @db.Date
  reminded30At DateTime? @map("reminded_30_at") @db.Timestamptz(3)
  reminded7At  DateTime? @map("reminded_7_at") @db.Timestamptz(3)
  reminded0At  DateTime? @map("reminded_0_at") @db.Timestamptz(3)
  resetAt      DateTime  @default(now()) @map("reset_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  garage       Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([state, dueOn])
  @@map("garage_document_cycle")
}

enum ListingDraftStatus {
  open
  submitted

  @@map("listing_draft_status")
}

// A garage listing a visitor began and left an e-mail on. Nothing looks a
// draft up by its address. The step's range is a CHECK in the migration.
model ListingDraft {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String
  data               Json                @default("{}")
  step               Int
  language           Language
  status             ListingDraftStatus  @default(open)
  remindedAt         DateTime?           @map("reminded_at") @db.Timestamptz(3)
  // The send that turned the draft into a garage: set together with
  // status submitted, its 201 body answered again to the same key.
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(3)
  submitKey          String?             @map("submit_key") @db.VarChar(64)
  submitResult       Json?               @map("submit_result")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set by every save, never by Prisma on its own.
  updatedAt          DateTime            @map("updated_at") @db.Timestamptz(3)
  // A copy of a live garage, opened to answer a request for more on this
  // file; null for a first listing. One open copy per file: the partial
  // unique index listing_draft_one_open_copy, in SQL.
  verificationFileId String?             @map("verification_file_id") @db.Uuid
  // The copy voice of the visit (1-5) when the form opened from Home, stored
  // only with analytics consent.
  copyVoice          Int?                @map("copy_voice") @db.SmallInt
  verificationFile   VerificationFile?   @relation(fields: [verificationFileId], references: [id], onDelete: Cascade)
  tokens             ListingDraftToken[]
  notifications      Notification[]

  @@index([status, updatedAt])
  @@index([verificationFileId])
  @@map("listing_draft")
}

// Who a draft's key went to: the browser that saved it, a link e-mail (the
// only kind the hourly cap counts), or the reminder.
enum ListingDraftTokenKind {
  browser
  link
  reminder

  @@map("listing_draft_token_kind")
}

// A key to a draft: the SHA-256 of a token, never the token.
model ListingDraftToken {
  hash    String                @id
  draftId String                @map("draft_id") @db.Uuid
  sentAt  DateTime              @map("sent_at") @db.Timestamptz(3)
  kind    ListingDraftTokenKind
  draft   ListingDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, sentAt])
  @@map("listing_draft_token")
}

// Declared in the order the summary line and the screens list them.
enum VerificationCheckKind {
  company
  caen
  rar
  activities
  representative
  address
  photos
  documents

  @@map("verification_check_kind")
}

enum VerificationCheckResult {
  not_run
  ok
  warning
  failed

  @@map("verification_check_result")
}

// One per file and kind, created with the file. `automatic` stays false until
// the registers are looked up by machine. The migration caps `detail` at 200
// characters.
model VerificationCheck {
  id         String                  @id @default(uuid()) @db.Uuid
  fileId     String                  @map("file_id") @db.Uuid
  kind       VerificationCheckKind
  automatic  Boolean                 @default(false)
  result     VerificationCheckResult @default(not_run)
  detail     String?
  recordedBy String?                 @map("recorded_by") @db.Uuid
  recordedAt DateTime?               @map("recorded_at") @db.Timestamptz(3)
  // What the admin found in the registers: company and caen only.
  evidence   Json?
  file       VerificationFile        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind])
  @@map("verification_check")
}

enum RecheckKind {
  rar

  @@map("recheck_kind")
}

enum RecheckResult {
  ok
  failed

  @@map("recheck_result")
}

enum RecheckFailure {
  expired
  suspended
  withdrawn

  @@map("recheck_failure")
}

// An admin's monthly look-up of an approved garage in a register, by hand
// (`automatic` stays false). CHECKs in the migration: `failure` and `detail`
// are set exactly when the result is failed, the detail 1 to 200 characters.
model Recheck {
  id            String          @id @default(uuid()) @db.Uuid
  garageId      String          @map("garage_id") @db.Uuid
  kind          RecheckKind     @default(rar)
  // The Bucharest day of the look-up.
  checkedOn     DateTime        @map("checked_on") @db.Date
  result        RecheckResult
  failure       RecheckFailure?
  detail        String?
  // The activities recorded on a valid result; empty on a failure.
  rarActivities String[]        @default([]) @map("rar_activities")
  automatic     Boolean         @default(false)
  recordedBy    String?         @map("recorded_by") @db.Uuid
  recordedAt    DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  garage        Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId, recordedAt])
  @@map("recheck")
}

// The activities a RAR authorisation can list; the migration seeds them.
model RarActivity {
  code   String @id
  nameRo String @map("name_ro")
  nameEn String @map("name_en")

  @@map("rar_activity")
}
