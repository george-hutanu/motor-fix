// auth module models

enum Role {
  driver
  garage
  receptionist
  mechanic
  admin

  @@map("role")
}

enum Language {
  ro
  en

  @@map("language")
}

enum AccountStatus {
  active
  suspended
  deleted

  @@map("account_status")
}

enum SignInMethod {
  password
  google
  apple
  whatsapp_phone

  @@map("sign_in_method")
}

model Account {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String?                  @unique
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  phone                   String?                  @unique
  phoneVerifiedAt         DateTime?                @map("phone_verified_at") @db.Timestamptz(3)
  name                    String
  city                    String?
  language                Language                 @default(ro)
  status                  AccountStatus            @default(active)
  lastRole                Role                     @map("last_role")
  lastActiveAt            DateTime?                @map("last_active_at") @db.Timestamptz(3)
  emailBouncedAt          DateTime?                @map("email_bounced_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  roles                   AccountRole[]
  identities              AccountIdentity[]
  refreshTokens           RefreshToken[]
  memberships             GarageMember[]
  mechanic                Mechanic?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  smsCounters             SmsCounter[]
  tokens                  AccountToken[]
  reminders               Reminder[]
  cars                    Car[]
  consents                AccountConsent[]
  quoteRequests           QuoteRequest[]
  declinedRecipients      RequestRecipient[]       @relation("RecipientDeclinedBy")
  bookings                Booking[]                @relation("BookingDriver")
  confirmedBookings       Booking[]                @relation("BookingConfirmedBy")
  cancelledBookings       Booking[]                @relation("BookingCancelledBy")
  noShowBookings          Booking[]                @relation("BookingNoShowRecordedBy")
  jobs                    Job[]                    @relation("JobDriver")
  jobStageEntries         JobStageEntry[]          @relation("JobStageActor")

  @@map("account")
}

enum ConsentKind {
  terms
  privacy_notice

  @@map("consent_kind")
}

// One row per text accepted: which version, in which language, through which
// sign-in method, and when. Kept for as long as the account.
model AccountConsent {
  id          String       @id @default(uuid()) @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  kind        ConsentKind
  textVersion String       @map("text_version")
  language    Language
  method      SignInMethod
  acceptedAt  DateTime     @default(now()) @map("accepted_at") @db.Timestamptz(3)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_consent")
}

enum AccountTokenPurpose {
  email_confirm
  password_reset

  @@map("account_token_purpose")
}

// The live WhatsApp sign-in code of a number: one per number, a new code
// replaces the old. Only an HMAC of the code is kept.
model SignInCode {
  phone     String    @id
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("sign_in_code")
}

// A single-use link sent to the account holder; only the token's SHA-256
// hash is kept.
model AccountToken {
  id        String              @id @default(uuid()) @db.Uuid
  accountId String              @map("account_id") @db.Uuid
  purpose   AccountTokenPurpose
  tokenHash String              @unique @map("token_hash")
  // The address the link was sent to: it confirms that one only.
  email     String
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
  @@map("account_token")
}

model AccountRole {
  accountId String  @map("account_id") @db.Uuid
  role      Role
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, role])
  @@map("account_role")
}

model AccountIdentity {
  id           String       @id @default(uuid()) @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  method       SignInMethod
  subject      String
  passwordHash String?      @map("password_hash")
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([method, subject])
  @@index([accountId])
  @@map("account_identity")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  // Whether the family was opened with "keep me signed in".
  remember  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@map("refresh_token")
}
