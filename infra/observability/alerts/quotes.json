{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "quotes",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "decline-window-sweep-late",
          "title": "Decline windows closed late by the sweep",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The sweep, not their own timers, closed more than 10 decline windows in an hour: timers on the quote-timers queue are being lost ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues",
            "runbook": "Quote timers are being lost: check the quote-timers queue on the queues dashboard, Redis memory and eviction, and the worker logs."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_decline_windows_closed_total{job=~\"(.+/)?worker\", sweep=\"true\"}[1h]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        10
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "booking-lapse-sweep-late",
          "title": "Booking, request and approval timers run late by the sweep",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The sweep, not their own timers, lapsed bookings or expired waiting garages, requests, quotes and assistant approvals, more than 10 in an hour: timers on the booking-timers, request-timers or assistant-approval-timers queue are being lost ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues",
            "runbook": "Booking or request timers are being lost: check the booking-timers, request-timers and assistant-approval-timers queues on the queues dashboard, Redis memory and eviction, and the worker logs."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_booking_lapses_total{job=~\"(.+/)?worker\", sweep=\"true\"}[1h]) or increase(motorfix_request_timers_total{job=~\"(.+/)?worker\", sweep=\"true\", step=~\"recipient_expired|request_closed|quote_expired\"}[1h]) or increase(motorfix_assistant_approvals_total{job=~\"(.+/)?worker\", outcome=\"expired\", sweep=\"true\"}[1h]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        10
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "move-lapse-failed",
          "title": "Booking move lapses failing for good",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A move-lapse job failed its last attempt in the last 15 minutes: a driver's move ask stayed open past its lapse time and the driver was not told ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues",
            "runbook": "Read the worker's MoveLapse log lines for the move id, fix the cause; the quote-timers sweep lapses the move on its next pass."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_jobs_total{queue=\"quote-timers\", job_name=\"move-lapse\", outcome=\"failed\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
