{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "quotes",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "decline-window-sweep-late",
          "title": "Decline windows closed late by the sweep",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The sweep, not their own timers, closed more than 10 decline windows in an hour: timers on the quote-timers queue are being lost ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_decline_windows_closed_total{job=~\"(.+/)?worker\", sweep=\"true\"}[1h]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        10
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
