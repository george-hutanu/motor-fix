{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "worker",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "worker-down",
          "title": "Worker down",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker reported in the last day and has sent no telemetry for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 86400,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (count_over_time(target_info{service_name=\"worker\"}[24h])) unless max by (deployment_environment) (count_over_time(target_info{service_name=\"worker\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-saturation",
          "title": "Worker event loop saturated",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker event loop p99 delay has been above 0.5 s for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (nodejs_eventloop_delay_p99_seconds{service_name=\"worker\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-queue-backlog",
          "title": "Worker queue backlog",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The oldest waiting job on queue {{ $labels.queue }} has waited more than 10 minutes, for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment, queue) (motorfix_queue_oldest_waiting_seconds)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        600
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-jobs-failed",
          "title": "Worker jobs failed",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A job on queue {{ $labels.queue }} failed for the last time in the last 15 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment, queue) (increase(motorfix_jobs_total{outcome=\"failed\", queue!=\"verification-result\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
