{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "worker",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "worker-down",
          "title": "Worker down",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker reported in the last day and has sent no telemetry for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Open the worker service in Railway for this environment: check the latest deploy and its logs, restart it if it crashed; queues wait until it is back."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 86400,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (count_over_time(target_info{service_name=\"worker\"}[24h])) unless max by (deployment_environment) (count_over_time(target_info{service_name=\"worker\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-saturation",
          "title": "Worker event loop saturated",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker event loop p99 delay has been above 0.5 s for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Open the Worker dashboard: find the job that blocks the event loop in the traces, and roll back the last deploy if it brought it."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (nodejs_eventloop_delay_p99_seconds{service_name=\"worker\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-queue-backlog",
          "title": "Worker queue backlog",
          "condition": "B",
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The oldest waiting job on queue {{ $labels.queue }} has waited more than 10 minutes, for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Open the queues dashboard for this queue: check that the worker is up and consuming, look for a stuck or failing job, and restart the worker if it stopped."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment, queue) (motorfix_queue_oldest_waiting_seconds)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        600
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-queue-growing",
          "title": "Worker queue growing",
          "condition": "B",
          "for": "15m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The waiting jobs on queue {{ $labels.queue }} have kept growing for 15 minutes: the worker is not keeping up ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Open the queues dashboard for this queue: the worker is not keeping up; check that it is consuming, its failures and its event loop, and restart it if it stopped."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment, queue) (delta(motorfix_queue_waiting[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-jobs-failed",
          "title": "Worker jobs failed",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A job on queue {{ $labels.queue }} failed for the last time in the last 15 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Read the worker logs and traces for the failed job on this queue, fix the cause, and retry the job from the queue if its work is still needed."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment, queue) (increase(motorfix_jobs_total{outcome=\"failed\", queue!=\"verification-result\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-cdn-purge-failed",
          "title": "Worker CDN purges failing",
          "condition": "B",
          "for": "15m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker's CDN purges have failed for 15 minutes ({{ $labels.deployment_environment }}): public pages may stay stale for up to a minute past each edit, and the purge queue cdn:purge keeps growing. Check BUNNY_API_KEY and BUNNY_PULL_ZONE_ID and the \"cdn purge failed\" log lines.",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Check BUNNY_API_KEY and BUNNY_PULL_ZONE_ID on the worker and the \"cdn purge failed\" log lines; public pages stay stale until purges work."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_cdn_purges_total{outcome=\"failed\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "worker-memory",
          "title": "Worker memory high",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "The worker service has used more than 85% of its memory limit for 10 minutes and may be killed for running out ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-worker",
            "runbook": "Open the Memory share of limit panel on the overview dashboard: if worker memory keeps rising, restart the service in Railway and look for a leak in the jobs of the last deploy."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (process_memory_usage_bytes{service_name=\"worker\"} / on (deployment_environment, instance) motorfix_process_memory_limit_bytes{service_name=\"worker\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
