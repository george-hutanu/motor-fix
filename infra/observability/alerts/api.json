{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "api",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "api-down",
          "title": "API down",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "The api service reported in the last day and has sent no telemetry for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the api service in Railway for this environment: check the latest deploy and its logs, restart it if it crashed, and roll back a deploy that will not start."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 86400,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (count_over_time(target_info{service_name=\"api\"}[24h])) unless max by (deployment_environment) (count_over_time(target_info{service_name=\"api\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-error-rate",
          "title": "API error rate high",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 5% of api responses were 5xx, or more than 5% of static map renders failed on the tiles, in the last 10 minutes, over at least 20 ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the API dashboard and its Logs and traces row: find the route returning 5xx, read the error logs and traces, and roll back the last deploy if it brought the errors. If only the static maps fail (the Static map renders panel), the tile provider is down or slow: the page keeps the interactive map on tap and the CDN serves cached images stale for a week; set MAP_TILES_TILEJSON_URL to another TileJSON only if the outage lasts."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (label_replace((sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{service_name=\"api\", http_response_status_code=~\"5..\"}[10m])) / sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{service_name=\"api\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(http_server_request_duration_seconds_count{service_name=\"api\"}[10m])) >= 20), \"signal\", \"http\", \"\", \"\") or label_replace((sum by (deployment_environment) (rate(motorfix_static_map_renders_total{service_name=\"api\", outcome=\"tiles_failed\"}[10m])) / sum by (deployment_environment) (rate(motorfix_static_map_renders_total{service_name=\"api\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(motorfix_static_map_renders_total{service_name=\"api\"}[10m])) >= 20), \"signal\", \"static_map\", \"\", \"\"))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-latency",
          "title": "API latency high",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "The api p95 response time has been above 1.5 s for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the API dashboard: find the slow route and its traces, check PostgreSQL and Redis on their dashboards, and roll back the last deploy if it brought the slowness."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (deployment_environment, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"api\"}[10m])))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1.5
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-cache-fallback-rate",
          "title": "API cache falling back",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 5% of cached public reads (profile, brand Home, popular tiles) fell back to PostgreSQL because Redis failed, for 10 minutes, over at least 20 reads ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Redis is failing the cached public reads: check the Redis dashboard and the redis-unreachable alert, then the api logs for cache errors."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment) (rate(motorfix_cache_total{service_name=\"api\", outcome=\"fallback\"}[10m])) / sum by (deployment_environment) (rate(motorfix_cache_total{service_name=\"api\", outcome=~\"hit|miss|stale|coalesced|negative|fallback\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(motorfix_cache_total{service_name=\"api\", outcome=~\"hit|miss|stale|coalesced|negative|fallback\"}[10m])) >= 20)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-search-cache-fallback-rate",
          "title": "API search cache falling back",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 5% of garage search reads fell back to PostgreSQL because Redis failed, for 10 minutes, over at least 20 reads ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Redis is failing the search cache: check the Redis dashboard and the api logs for cache errors; search still answers from PostgreSQL, only slower."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment) (rate(motorfix_search_cache_total{service_name=\"api\", outcome=\"fallback\"}[10m])) / sum by (deployment_environment) (rate(motorfix_search_cache_total{service_name=\"api\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(motorfix_search_cache_total{service_name=\"api\"}[10m])) >= 20)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-search-log-failure-rate",
          "title": "API search log failing",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 5% of search log rows failed to be written, for 10 minutes, over at least 20 rows ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Search log rows are not being written: check the PostgreSQL dashboard and the api logs for the failed inserts."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment) (rate(motorfix_search_log_total{service_name=\"api\", outcome=\"failed\"}[10m])) / sum by (deployment_environment) (rate(motorfix_search_log_total{service_name=\"api\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(motorfix_search_log_total{service_name=\"api\"}[10m])) >= 20)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-prefetch-hit-rate",
          "title": "API pre-fetch hit rate low",
          "condition": "B",
          "for": "60m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "Fewer than 30% of the warmed {{ $labels.kind }} entries were taken by the next read, for 60 minutes, over at least 50 warms ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Warmed cache entries go unused: check the pre-fetch panel per kind on the API dashboard and whether a recent change altered the cache keys."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment, kind) (increase(motorfix_cache_total{service_name=\"api\", kind=~\"driver-home|garage-home\", outcome=\"hit\"}[1h])) / sum by (deployment_environment, kind) (increase(motorfix_cache_total{service_name=\"api\", kind=~\"driver-home|garage-home\", outcome=\"warm\"}[1h]))) and on (deployment_environment, kind) (sum by (deployment_environment, kind) (increase(motorfix_cache_total{service_name=\"api\", kind=~\"driver-home|garage-home\", outcome=\"warm\"}[1h])) >= 50)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-search-latency",
          "title": "API search latency high",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "The garage search p95 response time has been above 300 ms for 10 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the Search p95 panel on the API dashboard and the slow search traces: check the PostgreSQL dashboard and the search cache fallback rate, and roll back the last deploy if it brought the slowness."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (deployment_environment, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"api\", http_route=\"/api/v1/search/garages\"}[5m])))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-profile-latency",
          "title": "API profile latency high",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "The garage profile p95 response time has been above 300 ms for 10 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the Profile p95 panel on the API dashboard and the slow profile traces: check the profile cache hit rate (motorfix_cache_total, kind profile) and the PostgreSQL dashboard, and roll back the last deploy if it brought the slowness."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (deployment_environment, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"api\", http_route=\"/api/v1/garages/:slug\"}[5m])))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-memory",
          "title": "API memory high",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "The api service has used more than 85% of its memory limit for 10 minutes and may be killed for running out ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Open the Memory share of limit panel on the overview dashboard: if api memory keeps rising, restart the service in Railway and look for a leak in the last deploy; raise the Railway limit only if the load justifies it."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (process_memory_usage_bytes{service_name=\"api\"} / on (deployment_environment, instance) motorfix_process_memory_limit_bytes{service_name=\"api\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-rate-limit-surge",
          "title": "API calls refused past a rate limit surge",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 30 calls a minute refused past a rate limit on {{ $labels.route }} for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "An attack or a limit set too tight. Read the api logs for the route's callers: one address or account flooding is an attack (block it at the edge firewall); many ordinary users refused means the limit is too low, and its number is raised in libs/domain/src/rate-limit/rate-limit.config.ts."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment, route) (increase(motorfix_rate_limit_refusals_total{service_name=\"api\"}[1m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        30
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-account-deletion-failed",
          "title": "API account deletions failing",
          "condition": "B",
          "for": "0m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "An account deletion failed in the last 15 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "Someone asked to delete their account and it stayed active. Read the api logs for 'account deletion' at that time and the PostgreSQL dashboard; the person can try again once the cause is fixed."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_account_deletions_total{service_name=\"api\", outcome=\"failed\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "api-admin-account-action-failed",
          "title": "API admin account actions failing",
          "condition": "B",
          "for": "0m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "An admin account action failed in the last 15 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-api",
            "runbook": "An admin's reset, suspend, restore or delete on request ended in a server error and the account kept its state. Read the api logs for 'admin account action' with outcome failed at that time and the PostgreSQL dashboard; the admin can run the action again once the cause is fixed."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_admin_account_actions_total{service_name=\"api\", outcome=\"failed\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
