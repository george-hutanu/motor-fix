{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "support",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "support-message-unsent",
          "title": "Support messages not mailed to the support mailbox",
          "condition": "B",
          "for": "60m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A contact message has waited more than an hour for its support e-mail: neither SUPPORT_EMAIL nor EMAIL_DOMAIN is set, or sending fails ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-product",
            "runbook": "Check SUPPORT_EMAIL, EMAIL_DOMAIN and EMAIL_FROM on the worker, the worker's Support log lines and the support-messages queue on the queues dashboard; once the address is set, the waiting messages are mailed by the worker's next sweep."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (motorfix_support_messages_unsent{job=~\"(.+/)?worker\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
