{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "mcp",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "mcp-auth-failures",
          "title": "MCP authentication failures spike",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "More than 20 MCP calls were refused at sign-in in 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "Read the MCP logs for the refused sign-ins: a broken client, an expired key or an attack; check the identity server too."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(mcp_auth_failures_total{job=~\"(.+/)?mcp\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-tool-errors",
          "title": "MCP tool error rate",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "More than 20% of MCP tool calls failed over 10 minutes, with at least 10 calls ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "Open the MCP dashboard: find the failing tool, read its error logs and traces, and roll back the last deploy if it brought the errors."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment) (increase(mcp_tool_calls_total{job=~\"(.+/)?mcp\", outcome=\"error\"}[10m])) / sum by (deployment_environment) (increase(mcp_tool_calls_total{job=~\"(.+/)?mcp\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(mcp_tool_calls_total{job=~\"(.+/)?mcp\"}[10m])) >= 10)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.2
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-key-fetch-failures",
          "title": "MCP cannot fetch the identity server signing keys",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "The MCP server failed to fetch the identity server signing keys in the last 5 minutes; sign-ins fail once cached keys expire ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "The MCP server cannot fetch the identity server keys: check that the identity server is up and reachable from the MCP service."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(mcp_key_fetches_total{job=~\"(.+/)?mcp\", outcome=\"error\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-issuer-unreachable",
          "title": "MCP cannot reach its identity server",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "The MCP server has not reached its identity server's discovery document for 5 minutes; assistants cannot sign in or refresh ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "The MCP server cannot reach its identity server: check the identity server in Railway and the MCP service's issuer setting."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (mcp_issuer_up{job=~\"(.+/)?mcp\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-down",
          "title": "MCP server down on staging",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "The staging MCP server has reported nothing for 5 minutes after reporting in the last 24 hours: it is down.",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "Open the MCP service in Railway for staging: check its latest deploy and logs, and restart it if it crashed."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 86400,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (count_over_time(mcp_issuer_up{job=~\"(.+/)?mcp\", deployment_environment=\"staging\"}[24h])) unless max by (deployment_environment) (count_over_time(mcp_issuer_up{job=~\"(.+/)?mcp\", deployment_environment=\"staging\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-memory",
          "title": "MCP memory high",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "The mcp service has used more than 85% of its memory limit for 10 minutes and may be killed for running out ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "Open the Memory share of limit panel on the overview dashboard: if MCP memory keeps rising, restart the service in Railway and look for a leak in the last deploy."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (process_memory_usage_bytes{service_name=\"mcp\"} / on (deployment_environment, instance) motorfix_process_memory_limit_bytes{service_name=\"mcp\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "mcp-rate-limit-surge",
          "title": "MCP calls refused past the rate limit surge",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "mcp"
          },
          "annotations": {
            "summary": "More than 30 calls a minute refused past a rate limit on {{ $labels.route }} for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-mcp",
            "runbook": "An attack or a limit set too tight. Read the MCP logs for the route's callers: one address or account flooding is an attack (block it at the edge firewall); many ordinary users refused means the limit is too low, and its number is raised in libs/domain/src/rate-limit/rate-limit.config.ts."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment, route) (increase(motorfix_rate_limit_refusals_total{service_name=\"mcp\"}[1m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        30
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
