{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "web",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "web-down",
          "title": "Web down",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "web"
          },
          "annotations": {
            "summary": "The web service reported in the last day and has sent no telemetry for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-web"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 86400,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max by (deployment_environment) (count_over_time(target_info{service_name=\"web\"}[24h])) unless max by (deployment_environment) (count_over_time(target_info{service_name=\"web\"}[5m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "web-error-rate",
          "title": "Web error rate high",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "web"
          },
          "annotations": {
            "summary": "More than 5% of web responses were 5xx in the last 10 minutes, over at least 20 responses ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-web"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{service_name=\"web\", http_response_status_code=~\"5..\"}[10m])) / sum by (deployment_environment) (rate(http_server_request_duration_seconds_count{service_name=\"web\"}[10m]))) and on (deployment_environment) (sum by (deployment_environment) (increase(http_server_request_duration_seconds_count{service_name=\"web\"}[10m])) >= 20)",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "web-latency",
          "title": "Web latency high",
          "condition": "B",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "web"
          },
          "annotations": {
            "summary": "The web p95 response time has been above 3 s for 5 minutes ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-web"
          },
          "notification_settings": {
            "receiver": "MotorFix owner"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (deployment_environment, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"web\"}[10m])))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
