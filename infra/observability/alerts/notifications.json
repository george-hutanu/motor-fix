{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "notifications",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "verification-result-failed",
          "title": "Verification result messages failing for good",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A verification result job failed its last attempt in the last 15 minutes: a garage owner was not told how their verification was decided ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues",
            "runbook": "Read the worker logs for the failed verification result job, fix the cause and send the result to the garage owner again."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_jobs_total{queue=\"verification-result\", outcome=\"failed\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "notification-fallback-rate",
          "title": "Many notifications sent on another channel",
          "condition": "B",
          "for": "15m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "More than 20 notifications in the last hour went on another channel than the one the driver chose ({{ $labels.deployment_environment }}): push, SMS or WhatsApp is failing, or the SMS allowance is spent.",
            "dashboard_uid": "motorfix-product",
            "runbook": "Open the Notifications sent on another channel panel to see which channel and reason. For send_failed, read the worker logs of the notifications queue for the provider error; for no_device or phone_not_verified, check the push and phone verification flows; for sms_cap_reached, the WhatsApp fallback is working as designed, so check whether the cap needs a decision."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_notification_channel_fallbacks_total[1h]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
