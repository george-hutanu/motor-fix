{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "notifications",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "verification-result-failed",
          "title": "Verification result messages failing for good",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "worker"
          },
          "annotations": {
            "summary": "A verification result job failed its last attempt in the last 15 minutes: a garage owner was not told how their verification was decided ({{ $labels.deployment_environment }}).",
            "dashboard_uid": "motorfix-queues"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_jobs_total{queue=\"verification-result\", outcome=\"failed\"}[15m]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
