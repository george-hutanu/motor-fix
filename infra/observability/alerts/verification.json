{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "verification",
      "folder": "MotorFix",
      "interval": "1m",
      "rules": [
        {
          "uid": "verification-rejection-burst",
          "title": "Rejection burst",
          "condition": "B",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "service": "api"
          },
          "annotations": {
            "summary": "More than 5 garage verification files were rejected in an hour ({{ $labels.deployment_environment }}): a wave of bad sign-ups, or an admin rejecting by mistake.",
            "dashboard_uid": "motorfix-product",
            "runbook": "Open the Garage rejections row on the product dashboard: one reason dominating points at a sign-up wave or a broken upload step; many reasons at once, at one admin's decisions. Read the rejected files in the admin queue and reopen any decided by mistake."
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "grafanacloud-prom",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum by (deployment_environment) (increase(motorfix_verification_rejections_total{job=~\"(.+/)?api\"}[1h]))",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
