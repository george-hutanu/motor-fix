        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.75, {app_name=\"$web_app\", kind=\"measurement\"} | logfmt | app_environment=\"$env\" | type=\"web-vitals\" | unwrap inp [$__auto]) by (view_name, context_viewport)",
          "legendFormat": "{{view_name}} {{context_viewport}}"
        }
