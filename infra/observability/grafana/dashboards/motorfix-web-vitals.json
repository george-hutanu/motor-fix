{
  "id": null,
  "uid": "motorfix-web-vitals",
  "title": "MotorFix — Web Vitals",
  "description": "Core Web Vitals and browser errors from Faro, by route, release and viewport.",
  "tags": [
    "motorfix"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "/^(?!.*usage).*$/"
      },
      {
        "name": "loki",
        "label": "loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment)",
          "refId": "env"
        },
        "definition": "label_values(target_info, deployment_environment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "web_app",
        "type": "constant",
        "query": "web",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "type": "tags",
          "tags": [
            "deploy",
            "env:$env"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "MotorFix",
      "type": "dashboards",
      "tags": [
        "motorfix"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Web Vitals, p75 by route and viewport (from the browser)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LCP",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.75, {app_name=\"$web_app\", kind=\"measurement\"} | logfmt | app_environment=\"$env\" | type=\"web-vitals\" | unwrap lcp [$__auto]) by (view_name, context_viewport)",
          "legendFormat": "{{view_name}} {{context_viewport}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "INP",
      "datasource": {
        "type": "loki",
