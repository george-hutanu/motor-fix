{
  "id": null,
  "uid": "motorfix-web",
  "title": "MotorFix — Web (SSR)",
  "description": "The web service: health, requests by route, outside calls, logs and traces.",
  "tags": [
    "motorfix"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "/^(?!.*usage).*$/"
      },
      {
        "name": "loki",
        "label": "loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment)",
          "refId": "env"
        },
        "definition": "label_values(target_info, deployment_environment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "type": "tags",
          "tags": [
            "deploy",
            "env:$env"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "MotorFix",
      "type": "dashboards",
      "tags": [
        "motorfix"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
