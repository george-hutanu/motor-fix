    "list": [
      {
        "name": "prom",
        "label": "prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "/^(?!.*usage).*$/"
      },
      {
        "name": "loki",
        "label": "loki",
