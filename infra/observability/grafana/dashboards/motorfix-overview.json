            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(rate(process_cpu_time_seconds_total{service_name=\"api\", deployment_environment=\"$env\"}[5m]))",
          "legendFormat": "cores"
        }
      ],
      "fieldConfig": {
