{
  "id": null,
  "uid": "motorfix-overview",
  "title": "MotorFix — Overview",
  "description": "Every service at a glance: up, rate, errors, p95, CPU, heap and release, per environment.",
  "tags": [
    "motorfix"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "/^(?!.*usage).*$/"
      },
      {
        "name": "loki",
        "label": "loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment)",
          "refId": "env"
        },
        "definition": "label_values(target_info, deployment_environment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "usage",
        "label": "usage",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "regex": "/usage/"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Deploys",
        "target": {
          "type": "tags",
          "tags": [
            "deploy",
            "env:$env"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "MotorFix",
      "type": "dashboards",
      "tags": [
        "motorfix"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "api",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max(target_info{service_name=\"api\", deployment_environment=\"$env\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
