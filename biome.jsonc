{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ["./**"]
            ]
          }
        },
        "useSortedKeys": "on"
      }
    }
  },
  "files": {
    "includes": [
      "apps/**",
      "libs/**",
      "scripts/**",
      "*.ts",
      "*.js",
      "*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.log",
      "!apps/api/openapi.json",
      "!libs/data-access/src/lib",
      "!libs/domain/src/generated",
      "!apps/web-e2e/test-output",
      "!!.claude/worktrees",
      "!!.worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noStaticOnlyClass": "off",
        "noVoid": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnreachable": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noVoidTypeReturn": "error",
        "useIsNan": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useConsistentMemberAccessibility": "error",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      // Biome reads Angular templates as plain HTML: it cannot see the photo tiles' bound [alt] or the placeholder's bound [attr.aria-label].
      "includes": [
        "apps/web/src/app/public/garage-profile/photos-section/photos-section.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useAltText": "off"
          }
        }
      }
    },
    {
      // Biome reads Angular templates as plain HTML: it cannot see these comboboxes' [attr.aria-*] bindings, and it flags the ARIA combobox (a ul listbox whose options are reached by aria-activedescendant, never focused).
      "includes": [
        "apps/web/src/app/dashboard/add-car/add-car.html",
        "apps/web/src/app/home/brand-picker/brand-search/brand-search.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    },
    {
      // Biome reads Angular templates as plain HTML: it cannot see the brand tiles' [attr.aria-checked] (buttons in the APG radio pattern, not native radios) or the href routerLink writes on Home's main button.
      "includes": [
        "apps/web/src/app/home/home.html",
        "apps/web/src/app/home/brand-picker/brand-picker.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsForRole": "off",
            "useSemanticElements": "off",
            "useValidAnchor": "off"
          }
        }
      }
    },
    {
      // Biome reads Angular templates as plain HTML: it cannot see the href that routerLink or a bound [href] writes on these links.
      "includes": [
        "apps/web/src/app/dashboard/admin-panel/admin-panel.html",
        "apps/web/src/app/dashboard/driver-home/driver-home.html",
        "apps/web/src/app/dashboard/due-date-line/due-date-line.html",
        "apps/web/src/app/dashboard/frame/frame.html",
        "apps/web/src/app/dashboard/tab-bar/tab-bar.html",
        "apps/web/src/app/dashboard/view/view.html",
        "apps/web/src/app/dashboard/garage-requests/garage-requests-panel/garage-requests-panel.html",
        "apps/web/src/app/dashboard/requests-view/requests-view.html",
        "apps/web/src/app/home/preview/preview.html",
        "apps/web/src/app/maintenance/maintenance-page/maintenance-page.html",
        "apps/web/src/app/not-found/not-found.html",
        "apps/web/src/app/public/frame/frame.html",
        "apps/web/src/app/public/confirm-email/confirm-email.html",
        "apps/web/src/app/public/garage-profile/garage-profile.html",
        "apps/web/src/app/public/garage-profile/gone/gone.html",
        "apps/web/src/app/public/garage-profile/request-quote/request-quote.html",
        "apps/web/src/app/public/garage-profile/request-quote-button/request-quote-button.html",
        "apps/web/src/app/public/invite/invite.html",
        "apps/web/src/app/public/tab-bar/tab-bar.html",
        "apps/web/src/app/public/unsubscribe/unsubscribe.html",
        "apps/web/src/app/sign-in/consent/consent.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useValidAnchor": "off"
          }
        }
      }
    },
    {
      // A labelled role="group" of tiles, buttons or role chips outside any form, where a fieldset would be wrong.
      "includes": [
        "apps/web/src/app/dashboard/admin-panel/admin-panel.html",
        "apps/web/src/app/dashboard/frame/frame.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      // Biome cannot see that the label wraps hlm-switch, whose [inputId] names the input it renders.
      "includes": [
        "apps/web/src/app/dashboard/notification-settings/notification-settings.html"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      // The prefers-reduced-motion block must beat every component's own animation and transition, which only !important can do.
      "includes": ["libs/ui-cockpit/src/styles/cockpit.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/*.e2e-spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "libs/data-access/**", "libs/media/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@motor-fix/domain": "The web app never imports the server domain; use the generated client in @motor-fix/data-access."
                }
              }
            }
          }
        }
      }
    }
  ]
}
