{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ["./**"]
            ]
          }
        },
        "useSortedKeys": "on"
      }
    }
  },
  "files": {
    "includes": [
      "apps/**",
      "libs/**",
      "scripts/**",
      "*.ts",
      "*.js",
      "*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.log",
      "!apps/api/openapi.json",
      "!libs/data-access/src/lib",
      "!libs/domain/src/generated",
      "!apps/web-e2e/test-output",
      "!!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noStaticOnlyClass": "off",
        "noVoid": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnreachable": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noVoidTypeReturn": "error",
        "useIsNan": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useConsistentMemberAccessibility": "error",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      // The prefers-reduced-motion block must beat every component's own animation and transition, which only !important can do.
      "includes": ["libs/ui-cockpit/src/styles/cockpit.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/*.e2e-spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "libs/data-access/**", "libs/media/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@motor-fix/domain": "The web app never imports the server domain; use the generated client in @motor-fix/data-access."
                }
              }
            }
          }
        }
      }
    }
  ]
}
