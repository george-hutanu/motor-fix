#!/usr/bin/env sh
set -e
# No Nx daemon from a commit, slot or not: it outlives the hook in every worktree.
export NX_DAEMON=false
sh .husky/identity.sh check
# Typecheck, lint and test share the machine with other sessions: they take a
# heavy-command slot and run with heavy.sh's modest parallelism (NX_PARALLEL,
# and JEST_MAX_WORKERS, which jest.preset.cjs reads). The commit waits for a
# slot rather than skipping its checks.
#
# Typecheck and test cover the projects this branch affects, staged and
# unstaged changes included, against its merge base with origin/main: the
# same scope PR CI runs, and the shared Nx cache (heavy.sh) answers the rest.
# release.yml still runs every project before anything reaches production.
if ! git rev-parse --verify --quiet origin/main >/dev/null; then
  echo "pre-commit: origin/main is missing, so the affected projects cannot be worked out. Run: git fetch origin main" >&2
  exit 1
fi
base=$(git merge-base origin/main HEAD 2>/dev/null || echo origin/main)
sh scripts/heavy.sh sh -c "TZ=UTC npx nx affected -t typecheck test --base=$base && npm run lint"
